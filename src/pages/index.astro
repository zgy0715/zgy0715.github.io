      @keyframes letter-in { from { opacity: 0; transform: translateY(.12em); filter: blur(12px); } to { opacity: 1; transform: none; filter: blur(0); } }

      .hero-sub { position: relative; z-index: 1; margin: 0 0 .4em; font: 9px var(--mono); letter-spacing: .5em; color: var(--blue-dark); opacity: 0; animation: fade-in 1s 1.1s forwards, sub-ink 1.5s cubic-bezier(.6, 0, .2, 1) 2.6s forwards; }
      @keyframes sub-ink { to { color: var(--blue-light); } }
      .hero-stack { position: relative; z-index: 1; display: grid; justify-items: center; gap: 14px; width: min(100%, 1180px); padding: 90px 24px; }
      .hero-focus { max-width: 520px; margin: 4px 0 0; color: #222; font-size: clamp(15px, 1.5vw, 18px); line-height: 1.7; text-align: center; opacity: 0; animation: fade-in 1s 1.5s forwards, hero-copy-ink 1.5s cubic-bezier(.6, 0, .2, 1) 2.6s forwards; }
      .hero-motto { margin: -6px 0 0; color: var(--blue-dark); font: 11px var(--mono); letter-spacing: .24em; text-transform: uppercase; opacity: 0; animation: fade-in 1s 1.7s forwards, hero-copy-ink 1.5s cubic-bezier(.6, 0, .2, 1) 2.6s forwards; }
      .typed-cursor { display: inline-block; width: 2px; height: 1.05em; margin-left: 3px; background: currentColor; vertical-align: -2px; animation: cursor-blink 1s steps(1) infinite; }
      @keyframes cursor-blink { 50% { opacity: 0; } }
      .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 10px; opacity: 0; animation: fade-in 1s 1.8s forwards, hero-copy-ink 1.5s cubic-bezier(.6, 0, .2, 1) 2.6s forwards; }
      .hero-actions a { padding: 11px 16px; border: 1px solid currentColor; font: 10px var(--mono); letter-spacing: .12em; text-decoration: none; transition: background .2s, color .2s, border-color .2s; }
      .hero-actions a:first-child { background: #111; border-color: #111; color: #fff; animation: hero-button-shift 1.5s cubic-bezier(.6, 0, .2, 1) 2.6s forwards; }
      .hero-actions a:not(:first-child) { padding-inline: 8px; border-color: transparent; background: transparent; color: #111; animation: hero-secondary-ink 1.5s cubic-bezier(.6, 0, .2, 1) 2.6s forwards; }
      .hero-actions a:hover { background: var(--blue); border-color: var(--blue); color: #fff; }
      .hero-actions a:not(:first-child):hover { background: var(--blue-dark); border-color: var(--blue-dark); color: #fff; }
      .hero-actions a:first-child:hover { background: var(--blue-dark); border-color: var(--blue-dark); }
      @keyframes hero-button-shift { to { background: #fff; border-color: #fff; color: #0a0a0a; } }
      @keyframes hero-secondary-ink { to { color: #fff; border-color: #fff; } }
      @keyframes hero-copy-ink { to { color: #fff; } }
      @keyframes fade-in { to { opacity: 1; } }

      .scroll-down { position: absolute; z-index: 2; bottom: 22px; left: 50%; text-decoration: none; font: 400 clamp(1.2rem, 3vw, 2rem) var(--display); letter-spacing: .08em; opacity: 0; animation: fade-in 1s 3.4s forwards; transform: translateX(-50%); }
      .scroll-down b { display: block; background-image: linear-gradient(90deg, var(--blue-light), var(--pink), var(--gold), var(--pink), var(--blue-light)); background-size: 200%; color: transparent; -webkit-background-clip: text; background-clip: text; animation: gradient-slide 1.2s linear infinite, up-down 2s ease-in-out infinite; }
      @keyframes gradient-slide { to { background-position: 200%; } }
      @keyframes up-down { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

      /* ===== 最近进展 ===== */
      .activity-section { padding: clamp(68px, 9vw, 112px) var(--pad); background: var(--white); color: #000; }
      .activity-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
      .activity-title { margin: 0; font: 400 clamp(2rem, 4.5vw, 3.2rem) var(--display); letter-spacing: .05em; }
      .activity-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(0, 0, 0, .2); }
      .activity-item { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; min-height: 190px; padding: 20px 22px 16px 0; }
      .activity-item + .activity-item { padding-left: 22px; border-left: 1px solid rgba(0, 0, 0, .16); }
      .activity-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; font: 10px var(--mono); letter-spacing: .1em; }
      .activity-meta time { color: var(--blue-dark); }
      .activity-item h3 { margin: 0; font-size: 17px; line-height: 1.55; font-weight: 600; }
      .activity-item p { margin: 0; font-size: 14px; line-height: 1.85; color: #555; }
      .activity-item a { margin-top: auto; color: var(--blue-dark); font: 10px var(--mono); letter-spacing: .1em; text-decoration: none; }
      .activity-item a:hover { text-decoration: underline; text-underline-offset: 4px; }
      [data-theme="dark"] .activity-section { background: #101214; color: #eee; }
      [data-theme="dark"] .activity-item p { color: #bbb; }
      [data-theme="dark"] .activity-item + .activity-item { border-color: rgba(255, 255, 255, .2); }
      [data-theme="dark"] .activity-list { border-color: rgba(255, 255, 255, .28); }
      [data-theme="dark"] .activity-item a { color: var(--blue-light); }

      /* ===== Projects ===== */
      .projects { display: flex; flex-direction: column; justify-content: center; gap: 20px; min-height: 100svh; padding: 90px var(--pad); background: var(--blue); color: #fff; }
      .projects h2 { margin: 0; font: 400 clamp(2rem, 4.5vw, 3.2rem) var(--display); letter-spacing: .05em; }
      .projects h2 i { font: 11px var(--sans); font-style: normal; letter-spacing: .2em; vertical-align: super; }
      .featured-project { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(260px, .8fr); gap: 22px clamp(24px, 4vw, 52px); padding: clamp(22px, 3.5vw, 38px); border: 1px solid rgba(255, 255, 255, .46); background: rgba(255, 255, 255, .08); }
      .project-section-label { margin: 12px 0 0; font: 10px var(--mono); letter-spacing: .16em; color: rgba(255, 255, 255, .72); }
      .featured-eyebrow { margin: 0 0 14px; font: 10px var(--mono); letter-spacing: .18em; color: rgba(255, 255, 255, .72); }
      .featured-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 5px 16px; margin: 0; font: 400 clamp(2.4rem, 5vw, 4.2rem)/.98 var(--display); letter-spacing: .035em; }
      .featured-title-local { font: 500 clamp(1.05rem, 2vw, 1.4rem)/1.4 var(--sans); letter-spacing: .03em; }
      .featured-summary { max-width: 520px; margin: 14px 0 0; font-size: 15px; line-height: 1.75; color: rgba(255, 255, 255, .9); }
      .featured-facts { display: flex; align-items: center; }
      .featured-facts p { margin: 0; font-size: 14px; line-height: 1.8; color: rgba(255, 255, 255, .94); }
      .featured-stack { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, .25); }
      .featured-stack span { padding: 6px 10px; border: 1px solid rgba(255, 255, 255, .36); border-radius: 999px; font: 9px var(--mono); letter-spacing: .1em; }
      .featured-links { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-left: auto; }
      .featured-links a { font: 10px var(--mono); letter-spacing: .13em; text-decoration: none; }
      .featured-links a:hover { color: #dcefff; text-decoration: underline; text-underline-offset: 4px; }
      .project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
      .project-card { display: flex; flex-direction: column; gap: 16px; min-width: 0; min-height: 290px; padding: 22px; border: 1px solid rgba(255, 255, 255, .4); background: rgba(255, 255, 255, .055); transition: background .2s, border-color .2s, transform .2s, box-shadow .25s; }
      .project-card[hidden] { display: none; }
      .project-card:hover { transform: translateY(-3px); border-color: rgba(255, 255, 255, .75); background: rgba(255, 255, 255, .1); box-shadow: 0 16px 42px -16px rgba(0, 0, 0, .5); }
      .project-card-meta { display: flex; justify-content: space-between; gap: 10px; font: 9px var(--mono); letter-spacing: .12em; color: rgba(255, 255, 255, .76); }
      .project-card-status { display: inline-flex; align-items: center; gap: 7px; }
      .project-card-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--pink); }
      .project-card h3 { margin: 0; font: 400 clamp(1.75rem, 2.8vw, 2.6rem)/1 var(--display); letter-spacing: .025em; overflow-wrap: anywhere; }
      .project-card-name-local { font: 600 .58em/1.25 var(--sans); letter-spacing: .02em; }
      .project-card-sub { margin: 7px 0 0; font-size: 13px; color: rgba(255, 255, 255, .82); }
      .project-card-desc { margin: 0; font-size: 13px; line-height: 1.7; color: rgba(255, 255, 255, .88); }
      .project-card-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
      .project-card-tags span { padding: 5px 8px; border: 1px solid rgba(255, 255, 255, .32); border-radius: 999px; font: 8px var(--mono); letter-spacing: .08em; }
      .project-card-stats { display: flex; flex-wrap: wrap; gap: 12px; margin: 10px 0 0; font: 9px var(--mono); letter-spacing: .1em; color: rgba(255, 255, 255, .74); }
      .project-card-stats .stat-star { color: var(--gold); }
      .project-card-link { display: inline-flex; align-items: center; gap: 8px; width: fit-content; margin-top: auto; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, .28); font: 9px var(--mono); letter-spacing: .14em; text-decoration: none; transition: color .2s; }
      .project-card-link b { font: 400 16px var(--display); transition: transform .2s; }
      .project-card-link:hover { color: #dcefff; }
      .project-card-link:hover b { transform: translate(3px, -3px); }
      .projects-toggle { display: inline-flex; align-items: center; gap: 10px; width: fit-content; padding: 9px 0; border: 0; border-bottom: 1px solid rgba(255, 255, 255, .48); background: transparent; color: #fff; cursor: pointer; font: 10px var(--mono); letter-spacing: .12em; }
      .projects-toggle:hover { border-color: #fff; }
      .projects-toggle i { font-style: normal; font-size: 15px; transition: transform .2s; }
      .projects-toggle[aria-expanded="true"] i { transform: rotate(45deg); }
      .all-repos { display: inline-flex; gap: 10px; align-items: baseline; width: fit-content; font: 400 1.5rem var(--display); letter-spacing: .06em; text-decoration: none; transition: color .2s; }
      .all-repos:hover { color: var(--blue-dark); }
      .all-repos i { font-style: normal; transition: transform .2s; }
      .all-repos:hover i { transform: translate(4px, -4px); }

      /* ===== 关于我 ===== */
      .about { display: flex; flex-direction: column; justify-content: center; gap: 20px; padding: 76px var(--pad); background: var(--white); color: #000; }
      .about h2 { margin: 0; font: 400 clamp(2rem, 4.5vw, 3.2rem) var(--display); letter-spacing: .05em; }
      .about-intro { margin: 0; max-width: 600px; font-size: 15px; line-height: 1.8; color: #333; }
      .about-tags { display: flex; flex-wrap: wrap; gap: 8px; }
      .about-tags span { padding: 6px 10px; border: 1px solid rgba(0, 0, 0, .2); border-radius: 999px; font: 10px var(--mono); letter-spacing: .08em; }
      .about-more { display: flex; flex-wrap: wrap; gap: 10px 22px; }
      .about-more a { color: var(--blue-dark); font: 10px var(--mono); letter-spacing: .1em; text-decoration: none; }
      .about-more a:hover { text-decoration: underline; text-underline-offset: 4px; }

      /* ===== 兴趣墙 ===== */
      .fav { display: flex; flex-direction: column; justify-content: center; gap: clamp(24px, 5vw, 48px); min-height: 68svh; padding: 80px var(--pad); background: var(--black); color: #fff; overflow: hidden; }
      .fav h2 { margin: 0; padding: 0; font: 400 clamp(2rem, 4.5vw, 3.2rem) var(--display); letter-spacing: .05em; }
      .interest-groups { display: grid; gap: clamp(22px, 4vw, 38px); }
      .interest-group { display: grid; grid-template-columns: 96px minmax(0, 1fr); align-items: center; gap: 18px; padding-top: 16px; border-top: 1px solid rgba(255, 255, 255, .22); }
      .interest-group h3 { margin: 0; color: var(--blue-light); font: 10px var(--mono); letter-spacing: .18em; }
      .interest-marquee { overflow: hidden; }
      .interest-track { display: flex; width: max-content; animation: interest-marquee 34s linear infinite; }
      .interest-group:nth-child(even) .interest-track { animation-direction: reverse; animation-duration: 40s; }
      .interest-group:hover .interest-track { animation-play-state: paused; }
      .interest-set { display: flex; align-items: baseline; gap: clamp(28px, 5vw, 72px); padding-right: clamp(28px, 5vw, 72px); white-space: nowrap; font: 400 clamp(2.5rem, 6vw, 5rem)/1 var(--display); letter-spacing: .025em; }
      .interest-set i { color: var(--pink); font-size: .28em; font-style: normal; }
      @keyframes interest-marquee { to { transform: translateX(-50%); } }

      /* ===== 据点（原 Headquarter）===== */
      .hq { display: flex; flex-direction: column; justify-content: center; gap: 20px; min-height: 100svh; padding: 90px var(--pad); background: var(--pink); color: #fff; }
      .hq h2 { margin: 0; align-self: flex-end; font: 400 clamp(2rem, 4.5vw, 3.2rem) var(--display); letter-spacing: .05em; text-align: right; }
      .hq-desc { max-width: 560px; margin: 0; align-self: flex-end; font-size: 15px; line-height: 1.9; text-align: right; color: rgba(255, 255, 255, .92); }
      .hq-panel { position: relative; overflow: hidden; min-height: 500px; border: 1px solid rgba(255, 255, 255, .18); background: radial-gradient(ellipse at 50% 48%, #101a2d 0%, #080d18 48%, #05070d 78%); box-shadow: inset 0 0 100px rgba(51, 136, 187, .08); }
      #space-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .hq-meta { position: absolute; left: 18px; bottom: 16px; display: grid; gap: 4px; margin: 0; font: 9px var(--mono); letter-spacing: .16em; color: rgba(255, 255, 255, .65); }
      .hq-tag { position: absolute; right: 18px; top: 16px; font: 9px var(--mono); letter-spacing: .16em; color: rgba(255, 255, 255, .65); }
      /* 时间控制（右下角）与行星资料卡 */
      .hq-controls { position: absolute; right: 14px; bottom: 14px; z-index: 3; display: flex; align-items: center; gap: 10px; }
      .hq-controls button { padding: 5px 10px; border: 1px solid rgba(255, 255, 255, .32); border-radius: 999px; background: rgba(5, 9, 18, .55); color: #fff; cursor: pointer; font: 9px var(--mono); letter-spacing: .1em; line-height: 1.5; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); transition: border-color .2s, background .2s; }
      .hq-controls button:hover { border-color: #fff; }
      #hq-play { width: 30px; height: 30px; padding: 0; font-size: 12px; display: inline-flex; align-items: center; justify-content: center; }
      .hq-speed { display: inline-flex; overflow: hidden; border: 1px solid rgba(255, 255, 255, .32); border-radius: 999px; background: rgba(5, 9, 18, .55); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
      .hq-speed button { border: 0; border-radius: 0; background: none; -webkit-backdrop-filter: none; backdrop-filter: none; }
      .hq-speed button + button { border-left: 1px solid rgba(255, 255, 255, .18); }
      .hq-speed button[aria-pressed="true"] { background: var(--blue); color: #fff; }
      .planet-card { position: absolute; z-index: 4; width: min(250px, calc(100% - 24px)); padding: 14px 16px 12px; border: 1px solid rgba(255, 255, 255, .38); background: rgba(6, 10, 20, .9); color: #fff; box-shadow: 0 18px 44px -18px rgba(0, 0, 0, .65); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
      .planet-card[hidden] { display: none; }
      .planet-card h4 { display: flex; align-items: baseline; gap: 8px; margin: 0 24px 10px 0; font: 400 22px var(--display); letter-spacing: .05em; }
      .planet-card h4 .i18n-zh { font-weight: 700; font-size: 14px; }
      .planet-card-close { position: absolute; top: 0; right: 0; width: 30px; height: 30px; border: 0; background: rgba(255, 255, 255, .08); color: #fff; cursor: pointer; font: 16px var(--mono); line-height: 1; transition: background .2s; }
      .planet-card-close:hover { background: rgba(255, 255, 255, .22); }
      .planet-card dl { display: grid; gap: 5px; margin: 0; }
      .planet-card dl div { display: flex; justify-content: space-between; gap: 12px; font: 10px var(--mono); letter-spacing: .08em; }
      .planet-card dt { color: rgba(255, 255, 255, .6); }
      .planet-card dd { margin: 0; }
      .planet-card-line { margin: 10px 0 0; padding-top: 10px; border-top: 1px solid rgba(255, 255, 255, .2); font-size: 12px; line-height: 1.75; color: rgba(255, 255, 255, .92); }

      /* ===== Contact ===== */
      .contact { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 26px; min-height: 62svh; padding: 90px var(--pad) 40px; background: var(--pink); color: #fff; text-align: center; }
      .contact h2 { margin: 0; font: 400 clamp(2.2rem, 5vw, 3.6rem) var(--display); letter-spacing: .05em; }
      .contact-links { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(18px, 4vw, 42px); }
      .contact-links a { display: inline-flex; align-items: center; gap: 10px; font: 10px var(--mono); letter-spacing: .2em; text-decoration: none; transition: color .2s; }
      .contact-links a:hover { color: var(--blue-light); }
      .contact-links svg { width: 22px; height: 22px; fill: currentColor; }
      .contact footer { margin-top: 40px; font: 9px var(--mono); letter-spacing: .2em; color: rgba(255, 255, 255, .65); display: grid; gap: 8px; justify-items: center; }
      .foot-stats { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 16px; letter-spacing: .14em; }
      .foot-stats b { font-weight: 700; color: #fff; }

      /* ===== 回到顶部 ===== */
      .top-button { position: fixed; z-index: 50; right: 22px; bottom: 22px; display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid #fff; border-radius: 50%; background: var(--blue); color: #fff; text-decoration: none; font: 400 20px var(--display); opacity: 0; pointer-events: none; transform: translateX(16px); transition: opacity .3s, transform .3s, background .2s; }
      .top-button.visible { opacity: 1; pointer-events: auto; transform: none; }
      .top-button:hover { background: var(--blue-dark); }

      /* ===== 进场动画（借鉴 blur-fadein：从焦外到清晰）===== */
      .reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s cubic-bezier(.2, .7, .2, 1); }
      .reveal.visible { opacity: 1; transform: none; }

      @media (max-width: 760px) {
        .wordmark span { display: none; }
        .activity-head { align-items: flex-start; flex-direction: column; }
        .activity-list { grid-template-columns: 1fr; }
        .activity-item { min-height: 0; padding: 20px 0; }
        .activity-item + .activity-item { padding-left: 0; border-left: 0; border-top: 1px solid rgba(0, 0, 0, .16); }
        .featured-project { grid-template-columns: 1fr; gap: 22px; }
        .featured-facts { align-items: flex-start; }
        .featured-stack { align-items: flex-start; }
        .featured-links { width: 100%; margin-left: 0; }
        .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .project-card { min-height: 280px; padding: 18px; }
        .interest-groups { grid-template-columns: 1fr; }
        .hq h2, .hq-desc { align-self: flex-start; text-align: left; }
        .hq-panel { min-height: 400px; }
      }

      @media (max-width: 560px) {
        .project-grid { grid-template-columns: 1fr; }
        .interest-group { grid-template-columns: 1fr; gap: 12px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
        .hero { background: var(--black); }
        .hero-title { color: #fff; }
        .hero-sub { color: var(--blue-light); opacity: 1; }
        .hero-focus, .hero-motto, .hero-actions { opacity: 1; color: #fff; animation: none; }
        .hero-actions a:first-child { background: #fff; border-color: #fff; color: #0a0a0a; animation: none; }
        .hero-actions a:not(:first-child) { color: #fff; border-color: transparent; animation: none; }
        .topbar { color: #fff; }
        .hero-title span, .hero-sub, .scroll-down { opacity: 1; }
        .reveal { opacity: 1; transform: none; }
        .interest-track { animation: none; }
        .interest-set.is-copy { display: none; }
        .hq-controls { display: none; }
      }

      /* ===== 暗色主题（手动切换，首次跟随系统）===== */
      [data-theme="dark"] .about { background: #101214; color: #eee; }
      [data-theme="dark"] .about-intro { color: #ccc; }
      [data-theme="dark"] .about-tags span { border-color: rgba(255, 255, 255, .24); }
      /* 暗色下首屏开场直接用深色形态，不走白幕动画 */
      [data-theme="dark"] .hero { animation: none; background: var(--black); }
      [data-theme="dark"] .hero-title { animation: none; color: #fff; }
      [data-theme="dark"] .hero-sub { animation: none; opacity: 1; color: var(--blue-light); }
      [data-theme="dark"] .hero-focus, [data-theme="dark"] .hero-motto, [data-theme="dark"] .hero-actions { animation: none; opacity: 1; color: #fff; }
      [data-theme="dark"] .hero-actions a:first-child { background: #fff; border-color: #fff; color: #0a0a0a; }
      [data-theme="dark"] .hero-actions a:not(:first-child) { color: #fff; border-color: transparent; animation: none; }
      [data-theme="dark"] .topbar { animation: none; color: #fff; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#activity">跳到主要内容</a>

    <header class="topbar" id="topbar">
      <a class="wordmark" href="#top" aria-label="回到顶部"><b>YZBZGY</b><span><span class="i18n-zh">个人据点</span><span class="i18n-en">PERSONAL ARCHIVE</span></span></a>
      <div class="topbar-actions">
