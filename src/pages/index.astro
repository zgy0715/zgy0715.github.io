---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content="YZBzgy 的个人据点：学习方向、开源项目、学习笔记与正在制作的东西。" />
    <title>YZBZGY · 个人据点</title>
    <meta property="og:image" content="https://zgy0715.github.io/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%233388bb'/%3E%3Ctext x='32' y='45' font-family='sans-serif' font-size='38' font-weight='bold' fill='white' text-anchor='middle'%3EY%3C/text%3E%3C/svg%3E" />
    <link rel="alternate" type="application/rss+xml" title="学习笔记 RSS" href="/rss.xml" />
    <link rel="canonical" href="https://zgy0715.github.io/" />
    <meta property="og:title" content="YZBZGY · 个人据点" />
    <meta property="og:description" content="大三在读的 learning-in-public 据点：项目、学习笔记与喜欢的东西。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zgy0715.github.io/" />
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('site-theme');
          var lang = localStorage.getItem('site-lang') || 'zh';
          if (lang === 'en') {
            document.documentElement.classList.add('lang-en');
            document.documentElement.lang = 'en';
          }
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        color-scheme: light;
        --black: #0a0a0a;
        --white: #fff;
        --blue: #3388bb;
        --blue-dark: #287aac;
        --blue-light: #77bbdd;
        --pink: #ff8899;
        --gold: #bb9955;
        --sans: 'IBM Plex Sans SC', sans-serif;
        --display: 'Bebas Neue', sans-serif;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        --pad: clamp(20px, 6vw, 72px);
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--black); color: var(--white); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      button { color: inherit; font: inherit; }
      ::selection { color: #fff; background: var(--blue); }
      :focus-visible { outline: 2px solid var(--blue-light); outline-offset: 4px; }

      /* ===== 双语切换 ===== */
      .i18n-en { display: none; }
      html.lang-en .i18n-zh { display: none; }
      html.lang-en .i18n-en { display: inline; }
      /* 中文大标题加粗，弥补 Bebas Neue 无中文粗体的落差 */
      h2 .i18n-zh, .menu-panel nav a .i18n-zh, .flow-label .i18n-zh, .scroll-down .i18n-zh { font-weight: 700; letter-spacing: .06em; }

      .skip-link { position: fixed; z-index: 90; top: 12px; left: 12px; padding: 12px 16px; background: #fff; color: #000; font: 12px var(--mono); text-decoration: none; transform: translateY(-180%); }
      .skip-link:focus { transform: none; }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

      /* ===== 顶部栏 =====
         开场时页面是白底，顶栏文字先为深色，随首屏一起平滑转白 */
      .topbar { position: fixed; z-index: 60; inset: 0 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 16px var(--pad); color: #000; transition: transform .45s ease; animation: topbar-ink 1.5s cubic-bezier(.6, 0, .2, 1) 2.6s forwards; }
      .topbar.hidden { transform: translateY(-110%); }
      @keyframes topbar-ink { to { color: #fff; } }
      .wordmark { display: inline-flex; align-items: baseline; gap: 10px; text-decoration: none; }
      .wordmark b { font: 400 1.5rem var(--display); letter-spacing: .06em; }
      .wordmark span { font: 8px var(--mono); letter-spacing: .22em; opacity: .55; }
      .topbar-actions { display: flex; align-items: center; gap: 18px; }
      .theme-toggle { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 50%; background: none; cursor: pointer; font-size: 16px; line-height: 1; transition: transform .3s ease; }
      .theme-toggle:hover { transform: rotate(24deg); }
      .lang-toggle { display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border: 1px solid currentColor; border-radius: 999px; background: none; cursor: pointer; font: 10px var(--mono); letter-spacing: .1em; }
      .lang-toggle span { opacity: .4; transition: opacity .2s; }
      html.lang-zh .lang-toggle .lang-zh-mark, html.lang-en .lang-toggle .lang-en-mark { opacity: 1; font-weight: 700; }
      .lang-toggle i { font-style: normal; opacity: .35; }
      .sound-button { display: inline-flex; align-items: center; gap: 8px; padding: 6px 0; border: 0; background: none; cursor: pointer; font: 9px var(--mono); letter-spacing: .18em; }
      .sound-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; opacity: .45; }
      .sound-button[aria-pressed='true'] .sound-dot { background: var(--pink); opacity: 1; box-shadow: 0 0 8px var(--pink); }
      .menu-button { display: inline-flex; align-items: center; gap: 10px; padding: 6px 0; border: 0; background: none; cursor: pointer; font: 9px var(--mono); letter-spacing: .22em; }
      .menu-lines { position: relative; width: 24px; height: 10px; border-block: 1px solid currentColor; }
      .menu-lines::after { content: ''; position: absolute; inset: 3px 0 auto; border-top: 1px solid currentColor; }
      body.menu-open { overflow: hidden; }

      /* ===== 全屏菜单 ===== */
      .menu-panel { position: fixed; z-index: 70; inset: 0; display: grid; place-items: center; background: var(--blue); visibility: hidden; opacity: 0; transition: opacity .35s ease, visibility .35s; }
      .menu-panel.open { visibility: visible; opacity: 1; }
      .menu-panel nav { display: grid; gap: 4px; text-align: center; }
      .menu-panel nav a { font: 400 clamp(2.1rem, 6.5vw, 5rem) var(--display); letter-spacing: .04em; line-height: 1; text-decoration: none; opacity: 0; transform: translateY(18px); transition: opacity .4s ease, transform .4s ease, color .2s; }
      .menu-panel.open nav a { opacity: 1; transform: none; }
      .menu-panel.open nav a:nth-child(1) { transition-delay: .05s; }
      .menu-panel.open nav a:nth-child(2) { transition-delay: .1s; }
      .menu-panel.open nav a:nth-child(3) { transition-delay: .15s; }
      .menu-panel.open nav a:nth-child(4) { transition-delay: .2s; }
      .menu-panel.open nav a:nth-child(5) { transition-delay: .25s; }
      .menu-panel.open nav a:nth-child(6) { transition-delay: .3s; }
      .menu-panel.open nav a:nth-child(7) { transition-delay: .35s; }
      .menu-panel nav a:hover { color: var(--blue-dark); }
      .menu-close { position: absolute; top: 18px; right: var(--pad); width: 44px; height: 44px; border: 1px solid #fff; border-radius: 50%; background: transparent; cursor: pointer; font: 20px var(--mono); }

      /* ===== Hero 首屏 =====
         开场：白底黑字标题逐字母浮现 → 停留 → 整屏平滑过渡为黑底白字。
         只有一组元素，不存在两层画面的对齐问题。 */
      .hero { position: relative; min-height: 100lvh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fff; animation: hero-bg 1.5s cubic-bezier(.6, 0, .2, 1) 2.6s forwards; }
      @keyframes hero-bg { to { background: var(--black); } }
      .hero::before, .hero::after { content: ''; position: absolute; z-index: 0; width: 55vmax; aspect-ratio: 1; border-radius: 50%; filter: blur(90px); opacity: .14; }
      .hero::before { top: -18%; left: -12%; background: var(--blue); animation: drift 16s ease-in-out infinite alternate; }
      .hero::after { bottom: -22%; right: -10%; background: var(--pink); animation: drift 20s ease-in-out infinite alternate-reverse; }
      @keyframes drift { to { transform: translate(6%, 8%) scale(1.15); } }

      .hero-title { position: relative; z-index: 1; margin: 0; padding: 0 4vw; font: 400 clamp(4.6rem, 17vw, 16rem) var(--display); letter-spacing: .04em; line-height: .9; text-align: center; white-space: nowrap; color: #000; animation: hero-ink 1.5s cubic-bezier(.6, 0, .2, 1) 2.6s forwards; }
      @keyframes hero-ink { to { color: #fff; } }
      .hero-title span { display: inline-block; opacity: 0; animation: letter-in .7s ease forwards; }
      .hero-title span:nth-child(1) { animation-delay: .25s; }
      .hero-title span:nth-child(2) { animation-delay: .34s; }
      .hero-title span:nth-child(3) { animation-delay: .43s; }
      .hero-title span:nth-child(4) { animation-delay: .52s; }
      .hero-title span:nth-child(5) { animation-delay: .61s; }
      .hero-title span:nth-child(6) { animation-delay: .7s; }
      @keyframes letter-in { from { opacity: 0; transform: translateY(.12em); } to { opacity: 1; transform: none; } }

      .hero-sub { position: relative; z-index: 1; margin: 0 0 .4em; font: 9px var(--mono); letter-spacing: .5em; color: var(--blue-dark); opacity: 0; animation: fade-in 1s 1.1s forwards, sub-ink 1.5s cubic-bezier(.6, 0, .2, 1) 2.6s forwards; }
      @keyframes sub-ink { to { color: var(--blue-light); } }
      .hero-stack { position: relative; z-index: 1; display: grid; justify-items: center; gap: 14px; }
      @keyframes fade-in { to { opacity: 1; } }

      .scroll-down { position: absolute; z-index: 2; bottom: 22px; left: 50%; text-decoration: none; font: 400 clamp(1.6rem, 4vw, 2.6rem) var(--display); letter-spacing: .08em; opacity: 0; animation: fade-in 1s 3.4s forwards; transform: translateX(-50%); }
      .scroll-down b { display: block; background-image: linear-gradient(90deg, var(--blue-light), var(--pink), var(--gold), var(--pink), var(--blue-light)); background-size: 200%; color: transparent; -webkit-background-clip: text; background-clip: text; animation: gradient-slide 1.2s linear infinite, up-down 2s ease-in-out infinite; }
      @keyframes gradient-slide { to { background-position: 200%; } }
      @keyframes up-down { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

      /* ===== 横向文字流 ===== */
      .flow-section { position: relative; height: 340vh; background: var(--white); color: #000; }
      .flow-sticky { position: sticky; top: 0; height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: 4vh; overflow: hidden; padding: 0 4vw; }
      .flow-label { margin: 0; font: 400 clamp(1.8rem, 4vw, 2.6rem) var(--display); letter-spacing: .05em; }
      .flow-label i { font: 11px var(--sans); font-style: normal; letter-spacing: .2em; vertical-align: super; color: var(--blue); }
      .flow-track { display: flex; align-items: baseline; gap: 7vw; width: max-content; white-space: nowrap; font: 400 clamp(4.5rem, 16vw, 15rem) var(--display); line-height: 1; will-change: transform; }
      .flow-track i { font-style: normal; font-size: .3em; color: var(--blue); align-self: center; }
      .flow-note { margin: 0; max-width: 440px; font-size: 13px; line-height: 2; color: #333; }
      /* 底部渐变过渡到下一屏的蓝色 */
      .flow-fade { position: absolute; inset: auto 0 0; height: 26vh; background: linear-gradient(180deg, transparent, var(--blue)); pointer-events: none; }

      /* ===== Projects ===== */
      .projects { display: flex; flex-direction: column; justify-content: center; gap: 20px; min-height: 100svh; padding: 90px var(--pad); background: var(--blue); color: #fff; }
      .projects h2 { margin: 0; font: 400 clamp(2.4rem, 5.5vw, 4rem) var(--display); letter-spacing: .05em; }
      .projects h2 i { font: 11px var(--sans); font-style: normal; letter-spacing: .2em; vertical-align: super; }
      .slider { display: flex; gap: clamp(16px, 2.5vw, 28px); overflow-x: auto; scroll-snap-type: x mandatory; padding-block: 8px; scrollbar-width: none; }
      .slider::-webkit-scrollbar { display: none; }
      .slide { flex: 0 0 min(88vw, 700px); scroll-snap-align: center; display: flex; flex-direction: column; justify-content: space-between; gap: 26px; min-height: min(540px, 64svh); padding: clamp(22px, 3.5vw, 40px); border: 1px solid rgba(255, 255, 255, .5); background: rgba(255, 255, 255, .06); }
      .slide-meta { display: flex; justify-content: space-between; gap: 12px; font: 9px var(--mono); letter-spacing: .18em; }
      .slide-status { display: inline-flex; align-items: center; gap: 7px; }
      .slide-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--pink); }
      .slide-name { margin: 0; font: 400 clamp(3.2rem, 7.5vw, 6.2rem) var(--display); letter-spacing: .03em; line-height: .92; }
      .slide-sub { margin: 6px 0 0; font-size: 13px; color: rgba(255, 255, 255, .75); }
      .slide-desc { max-width: 460px; margin: 0; font-size: 13.5px; line-height: 2.05; color: rgba(255, 255, 255, .88); }
      .slide-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
      .slide-tags span { padding: 6px 10px; border: 1px solid rgba(255, 255, 255, .4); border-radius: 999px; font: 8px var(--mono); letter-spacing: .14em; }
      .slide-link { display: inline-flex; align-items: center; gap: 10px; width: fit-content; padding-top: 16px; margin-top: auto; border-top: 1px solid rgba(255, 255, 255, .35); font: 10px var(--mono); letter-spacing: .2em; text-decoration: none; transition: color .2s; }
      .slide-link b { font: 400 18px var(--display); transition: transform .2s; }
      .slide-link:hover { color: var(--blue-dark); }
      .slide-link:hover b { transform: translate(3px, -3px); }
      .slider-nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
      .slider-arrows { display: flex; gap: 10px; }
      .slider-arrows button { width: 44px; height: 44px; border: 1px solid #fff; border-radius: 50%; background: transparent; cursor: pointer; font: 400 18px var(--display); transition: background .2s, color .2s; }
      .slider-arrows button:hover { background: #fff; color: var(--blue); }
      .dots { display: flex; gap: 8px; }
      .dots button { width: 9px; height: 9px; padding: 0; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .35); cursor: pointer; transition: background .2s, transform .2s; }
      .dots button.active { background: #fff; transform: scale(1.25); }
      .all-repos { display: inline-flex; gap: 10px; align-items: baseline; width: fit-content; font: 400 1.5rem var(--display); letter-spacing: .06em; text-decoration: none; transition: color .2s; }
      .all-repos:hover { color: var(--blue-dark); }
      .all-repos i { font-style: normal; transition: transform .2s; }
      .all-repos:hover i { transform: translate(4px, -4px); }

      /* ===== 关于我 ===== */
      .about { display: flex; flex-direction: column; justify-content: center; gap: 26px; min-height: 100svh; padding: 90px var(--pad); background: var(--white); color: #000; }
      .about h2 { margin: 0; font: 400 clamp(2.4rem, 5.5vw, 4rem) var(--display); letter-spacing: .05em; }
      .about-intro { margin: 0; max-width: 580px; font-size: 13.5px; line-height: 2.1; color: #333; }
      .skill-list { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 22px; }
      .skill-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
      .skill-head b { font: 400 clamp(1.5rem, 3.2vw, 2.2rem) var(--display); letter-spacing: .05em; }
      .skill-head span { font: 10px var(--mono); letter-spacing: .15em; color: #666; }
      .skill-track { position: relative; height: 6px; margin-top: 8px; background: rgba(0, 0, 0, .12); overflow: hidden; }
      .skill-fill { position: absolute; inset: 0 auto 0 0; width: 100%; background: var(--blue); transform: scaleX(0); transform-origin: left; transition: transform 1.1s cubic-bezier(.2, .7, .2, 1) var(--d, 0ms); }
      .reveal.visible .skill-fill { transform: scaleX(var(--level)); }
      .skill-note { margin: 7px 0 0; font-size: 12px; color: #666; }
      .next-steps { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(24px, 4vw, 50px); margin-top: 10px; }
      .next-steps h3, .notes-preview h3 { margin: 0 0 14px; font: 400 clamp(1.4rem, 2.8vw, 2rem) var(--display); letter-spacing: .05em; }
      .next-steps ol { margin: 0; padding-left: 1.3em; font-size: 13px; line-height: 2; color: #333; }
      .next-steps li::marker { color: var(--blue); font-weight: 700; }
      .notes-preview ul { list-style: none; margin: 0; padding: 0; }
      .notes-preview li { border-top: 1px solid rgba(0, 0, 0, .15); }
      .notes-preview li:last-child { border-bottom: 1px solid rgba(0, 0, 0, .15); }
      .notes-preview a { display: flex; align-items: baseline; gap: 18px; padding: 13px 0; text-decoration: none; }
      .notes-preview time { font: 9px var(--mono); letter-spacing: .16em; color: #666; white-space: nowrap; }
      .notes-preview b { font-weight: 500; font-size: 14px; transition: color .2s; }
      .notes-preview a:hover b { color: var(--blue); }
      .all-notes { display: inline-flex; gap: 10px; align-items: baseline; margin-top: 18px; width: fit-content; font: 400 1.4rem var(--display); letter-spacing: .06em; text-decoration: none; transition: color .2s; }
      .all-notes:hover { color: var(--blue-dark); }
      .all-notes i { font-style: normal; transition: transform .2s; }
      .all-notes:hover i { transform: translate(4px, -4px); }

      /* ===== 兴趣墙 ===== */
      .fav { display: flex; flex-direction: column; justify-content: center; gap: 30px; min-height: 88svh; padding: 80px 0; background: var(--black); color: #fff; overflow: hidden; }
      .fav h2 { margin: 0; padding: 0 var(--pad); font: 400 clamp(2.4rem, 5.5vw, 4rem) var(--display); letter-spacing: .05em; }
      .marquee { overflow: hidden; }
      .marquee-track { display: flex; width: max-content; animation: marquee-move 30s linear infinite; }
      .marquee.reverse .marquee-track { animation-direction: reverse; animation-duration: 36s; }
      .marquee:hover .marquee-track { animation-play-state: paused; }
      .marquee-group { display: flex; align-items: baseline; gap: 5vw; padding-right: 5vw; white-space: nowrap; font: 400 clamp(3.5rem, 11vw, 9rem) var(--display); line-height: 1; }
      .marquee-group span:nth-child(4n+2) { color: var(--blue-light); }
      .marquee-group i { font-style: normal; font-size: .3em; color: var(--pink); align-self: center; }
      @keyframes marquee-move { to { transform: translateX(-50%); } }

      /* ===== 据点（原 Headquarter）===== */
      .hq { display: flex; flex-direction: column; justify-content: center; gap: 20px; min-height: 100svh; padding: 90px var(--pad); background: var(--pink); color: #fff; }
      .hq h2 { margin: 0; align-self: flex-end; font: 400 clamp(2.4rem, 5.5vw, 4rem) var(--display); letter-spacing: .05em; text-align: right; }
      .hq-desc { max-width: 560px; margin: 0; align-self: flex-end; font-size: 13px; line-height: 2; text-align: right; color: rgba(255, 255, 255, .92); }
      .hq-panel { position: relative; overflow: hidden; min-height: 440px; background: #05070d; }
      #space-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .hq-meta { position: absolute; left: 18px; bottom: 16px; display: grid; gap: 4px; margin: 0; font: 9px var(--mono); letter-spacing: .16em; color: rgba(255, 255, 255, .65); }
      .hq-tag { position: absolute; right: 18px; top: 16px; font: 9px var(--mono); letter-spacing: .16em; color: rgba(255, 255, 255, .65); }

      /* ===== Contact ===== */
      .contact { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 26px; min-height: 62svh; padding: 90px var(--pad) 40px; background: var(--pink); color: #fff; text-align: center; }
      .contact h2 { margin: 0; font: 400 clamp(2.6rem, 6vw, 4.4rem) var(--display); letter-spacing: .05em; }
      .contact-links { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(18px, 4vw, 42px); }
      .contact-links a { display: inline-flex; align-items: center; gap: 10px; font: 10px var(--mono); letter-spacing: .2em; text-decoration: none; transition: color .2s; }
      .contact-links a:hover { color: var(--blue-light); }
      .contact-links svg { width: 22px; height: 22px; fill: currentColor; }
      .contact footer { margin-top: 40px; font: 9px var(--mono); letter-spacing: .2em; color: rgba(255, 255, 255, .65); }

      /* ===== 回到顶部 ===== */
      .top-button { position: fixed; z-index: 50; right: 22px; bottom: 22px; display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid #fff; border-radius: 50%; background: var(--blue); color: #fff; text-decoration: none; font: 400 20px var(--display); opacity: 0; pointer-events: none; transform: translateX(16px); transition: opacity .3s, transform .3s, background .2s; }
      .top-button.visible { opacity: 1; pointer-events: auto; transform: none; }
      .top-button:hover { background: var(--blue-dark); }

      /* ===== 进场动画（借鉴 blur-fadein：从焦外到清晰）===== */
      .reveal { opacity: 0; transform: translateY(26px); filter: blur(8px); transition: opacity .8s ease, transform .8s cubic-bezier(.2, .7, .2, 1), filter .9s ease; }
      .reveal.visible { opacity: 1; transform: none; filter: blur(0); }

      @media (max-width: 760px) {
        .wordmark span { display: none; }
        .flow-section { height: auto; }
        .flow-sticky { position: static; height: auto; padding-block: 80px; overflow-x: auto; }
        .flow-track { transform: none !important; }
        .flow-fade { display: none; }
        .slide { min-height: 480px; }
        .next-steps { grid-template-columns: 1fr; }
        .hq h2, .hq-desc { align-self: flex-start; text-align: left; }
        .hq-panel { min-height: 330px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
        .hero { background: var(--black); }
        .hero-title { color: #fff; }
        .hero-sub { color: var(--blue-light); opacity: 1; }
        .topbar { color: #fff; }
        .hero-title span, .hero-sub, .scroll-down { opacity: 1; }
        .reveal { opacity: 1; transform: none; filter: blur(0); }
        .skill-fill { transform: scaleX(var(--level)); }
        .marquee-track { animation: none; }
        .flow-section { height: auto; }
        .flow-sticky { position: static; height: auto; overflow-x: auto; }
        .flow-fade { display: none; }
      }

      /* ===== 暗色主题（手动切换，首次跟随系统）===== */
      [data-theme="dark"] .flow-section { background: #101214; color: #eee; }
      [data-theme="dark"] .flow-label i { color: var(--blue-light); }
      [data-theme="dark"] .flow-track i { color: var(--blue-light); }
      [data-theme="dark"] .flow-note { color: #999; }
      [data-theme="dark"] .flow-fade { background: linear-gradient(180deg, transparent, rgba(51, 136, 187, .55)); }
      [data-theme="dark"] .about { background: #101214; color: #eee; }
      [data-theme="dark"] .about-intro { color: #bbb; }
      [data-theme="dark"] .skill-track { background: rgba(255, 255, 255, .16); }
      [data-theme="dark"] .skill-head span, [data-theme="dark"] .skill-note { color: #999; }
      [data-theme="dark"] .next-steps ol { color: #bbb; }
      [data-theme="dark"] .notes-preview li { border-color: rgba(255, 255, 255, .22); }
      [data-theme="dark"] .notes-preview time { color: #999; }
      /* 暗色下首屏开场直接用深色形态，不走白幕动画 */
      [data-theme="dark"] .hero { animation: none; background: var(--black); }
      [data-theme="dark"] .hero-title { animation: none; color: #fff; }
      [data-theme="dark"] .hero-sub { animation: fade-in 1s 1.1s forwards; color: var(--blue-light); }
      [data-theme="dark"] .topbar { animation: none; color: #fff; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#interests">跳到主要内容</a>

    <header class="topbar" id="topbar">
      <a class="wordmark" href="#top" aria-label="回到顶部"><b>YZBZGY</b><span><span class="i18n-zh">个人据点</span><span class="i18n-en">PERSONAL ARCHIVE</span></span></a>
      <div class="topbar-actions">
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换明暗主题">☾</button>
        <button class="lang-toggle" id="lang-toggle" type="button" aria-label="切换语言 / Switch language"><span class="lang-zh-mark">中</span><i aria-hidden="true">/</i><span class="lang-en-mark">EN</span></button>
        <button class="sound-button" id="sound" type="button" aria-pressed="false" aria-label="开启背景音效"><span class="sound-dot" aria-hidden="true"></span><span id="sound-label"><span class="i18n-zh">声音 关</span><span class="i18n-en">SOUND OFF</span></span></button>
        <button class="menu-button" id="menu-open" type="button" aria-expanded="false" aria-controls="menu"><span class="menu-lines" aria-hidden="true"></span><span><span class="i18n-zh">菜单</span><span class="i18n-en">MENU</span></span></button>
      </div>
    </header>

    <div class="menu-panel" id="menu" aria-hidden="true" inert>
      <button class="menu-close" id="menu-close" type="button" aria-label="关闭菜单">×</button>
      <nav aria-label="主导航">
        <a href="#top"><span class="i18n-zh">主页</span><span class="i18n-en">TOP</span></a>
        <a href="#interests"><span class="i18n-zh">兴趣</span><span class="i18n-en">INTERESTS</span></a>
        <a href="#projects"><span class="i18n-zh">项目</span><span class="i18n-en">PROJECTS</span></a>
        <a href="#about"><span class="i18n-zh">关于</span><span class="i18n-en">ABOUT</span></a>
        <a href="/notes/"><span class="i18n-zh">笔记</span><span class="i18n-en">NOTES</span></a>
        <a href="#map"><span class="i18n-zh">据点</span><span class="i18n-en">HEADQUARTER</span></a>
        <a href="#contact"><span class="i18n-zh">联系</span><span class="i18n-en">CONTACT</span></a>
      </nav>
    </div>

    <main id="main">
      <!-- 首屏：同一组元素完成 白底黑字 → 黑底白字 的平滑过渡 -->
      <section class="hero" id="top" aria-label="首屏">
        <div class="hero-stack">
          <p class="hero-sub"><span class="i18n-zh">个人据点 — 建于 {year}</span><span class="i18n-en">PERSONAL ARCHIVE — EST. {year}</span></p>
          <h1 class="hero-title" aria-label="YZBZGY"><span aria-hidden="true">Y</span><span aria-hidden="true">Z</span><span aria-hidden="true">B</span><span aria-hidden="true">Z</span><span aria-hidden="true">G</span><span aria-hidden="true">Y</span></h1>
        </div>
        <a class="scroll-down" href="#interests"><b aria-hidden="true"><span class="i18n-zh">往下滚动</span><span class="i18n-en">Scroll down</span></b><span class="sr-only">向下滚动</span></a>
      </section>

      <!-- 兴趣横向文字流 -->
      <section class="flow-section" id="interests" aria-label="兴趣方向">
        <div class="flow-sticky">
          <p class="flow-label"><span class="i18n-zh">最近在探索 <i>01</i></span><span class="i18n-en">Currently into <i>01</i></span></p>
          <div class="flow-track" id="flow-track">
            {keywords.map((word) => <><span>{word}</span><i aria-hidden="true">✳</i></>)}
          </div>
          <p class="flow-note"><span class="i18n-zh">最近在探索这些东西。写 Python、碰数据、学机器学习，顺手用 Java 交作业，剩下的时间都在动手做点小东西。</span><span class="i18n-en">Things I've been exploring lately — writing Python, playing with data, learning machine learning, handing in Java homework, and building small stuff with whatever time is left.</span></p>
        </div>
        <div class="flow-fade" aria-hidden="true"></div>
      </section>

      <!-- Projects -->
      <section class="projects" id="projects" aria-labelledby="projects-title">
        <h2 id="projects-title" class="reveal"><span class="i18n-zh">项目 <i>10</i></span><span class="i18n-en">Projects <i>10</i></span></h2>
        <div class="slider reveal" id="slider" tabindex="0" aria-label="项目列表，可左右滑动">
          {projects.map((project) => (
            <article class="slide">
              <div class="slide-meta"><span><span class="i18n-zh">项目 / {project.number}</span><span class="i18n-en">PROJECT / {project.number}</span></span><span class="slide-status"><span class="i18n-zh">{project.status}</span><span class="i18n-en">{project.statusEn}</span></span></div>
              <div>
                <h3 class="slide-name">{project.name}</h3>
                <p class="slide-sub"><span class="i18n-zh">{project.subtitle}</span><span class="i18n-en">{project.subtitleEn}</span></p>
              </div>
              <div>
                <p class="slide-desc"><span class="i18n-zh">{project.description}</span><span class="i18n-en">{project.descriptionEn}</span></p>
                <div class="slide-tags" aria-label="技术标签">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
              {project.href ? (
                <a class="slide-link" href={project.href} target="_blank" rel="noreferrer"><span><span class="i18n-zh">查看仓库</span><span class="i18n-en">VIEW REPOSITORY</span></span><b aria-hidden="true">↗</b></a>
              ) : (
                <p class="slide-link"><span><span class="i18n-zh">{project.note.zh}</span><span class="i18n-en">{project.note.en}</span></span></p>
              )}
            </article>
          ))}
        </div>
        <div class="slider-nav reveal">
          <div class="slider-arrows">
            <button id="slider-prev" type="button" aria-label="上一个项目">←</button>
            <button id="slider-next" type="button" aria-label="下一个项目">→</button>
          </div>
          <div class="dots" id="dots" aria-label="项目页码"></div>
        </div>
        <a class="all-repos reveal" href="https://github.com/zgy0715?tab=repositories" target="_blank" rel="noreferrer"><span><span class="i18n-zh">全部仓库</span><span class="i18n-en">ALL REPOSITORIES</span></span> <i aria-hidden="true">↗</i></a>
      </section>

      <!-- 关于我 -->
      <section class="about" id="about" aria-labelledby="about-title">
        <h2 id="about-title" class="reveal"><span class="i18n-zh">关于我</span><span class="i18n-en">About Me</span></h2>
        <p class="about-intro reveal"><span class="i18n-zh">在读本科生，大一从 C/C++ 起步（大一大二的代码至今留着专门的仓库），后来一路写到 Java 和 Python。GitHub 上现有 22 个公开仓库，语言占比最大的是 Python（27.7%）和 Java（23.6%），最近集中在大模型智能体方向。本页列出的项目全部来自这些仓库的真实数据。</span><span class="i18n-en">An undergrad who started with C/C++ in freshman year (that code still lives in its own repo), later moving through Java into Python. 22 public repos on GitHub so far, dominated by Python (27.7%) and Java (23.6%); lately focused on LLM agent projects. Every project on this page comes from those repos' real data.</span></p>
        <ul class="skill-list reveal" aria-label="语言占比（数据来源：GitHub API）">
          {skills.map((skill, i) => (
            <li class="skill-row" style={`--level:${(skill.share / 27.7).toFixed(3)}; --d:${i * 90}ms`}>
              <div class="skill-head"><b>{skill.name}</b><span>{skill.share}%</span></div>
              <div class="skill-track"><i class="skill-fill"></i></div>
              <p class="skill-note"><span class="i18n-zh">{skill.zh}</span><span class="i18n-en">{skill.en}</span></p>
            </li>
          ))}
        </ul>
        <div class="next-steps reveal">
          <div>
            <h3><span class="i18n-zh">下一步</span><span class="i18n-en">NEXT UP</span></h3>
            <ol>{plans.map((plan) => <li><span class="i18n-zh">{plan.zh}</span><span class="i18n-en">{plan.en}</span></li>)}</ol>
          </div>
          <div class="notes-preview">
            <h3><span class="i18n-zh">最新笔记</span><span class="i18n-en">LATEST NOTES</span></h3>
            {latestNotes.length === 0 ? <p class="skill-note"><span class="i18n-zh">笔记整理中。</span><span class="i18n-en">Notes coming soon.</span></p> : (
              <ul>
                {latestNotes.map((n) => (
                  <li><a href={`/notes/${n.id}/`}><time>{n.data.date.toISOString().slice(0, 10).replace(/-/g, '.')}</time><b>{n.data.title}</b></a></li>
                ))}
              </ul>
            )}
            <a class="all-notes" href="/notes/"><span class="i18n-zh">全部笔记</span><span class="i18n-en">ALL NOTES</span> <i aria-hidden="true">↗</i></a>
          </div>
        </div>
      </section>

      <!-- 兴趣墙 -->
      <section class="fav" id="fav" aria-labelledby="fav-title">
        <h2 id="fav-title" class="reveal"><span class="i18n-zh">喜欢的东西</span><span class="i18n-en">Favorites</span></h2>
        <div class="marquee" aria-hidden="true"><div class="marquee-track">
          {[0, 1].map(() => <div class="marquee-group">{favs.map((f) => <><span>{f}</span><i>✳</i></>)}</div>)}
        </div></div>
        <div class="marquee reverse" aria-hidden="true"><div class="marquee-track">
          {[0, 1].map(() => <div class="marquee-group">{favs.map((f) => <><span>{f}</span><i>✳</i></>)}</div>)}
        </div></div>
      </section>

      <!-- 据点（原 Headquarter）-->
      <section class="hq" id="map" aria-labelledby="hq-title">
        <h2 id="hq-title" class="reveal"><span class="i18n-zh">我的据点</span><span class="i18n-en">Headquarter</span></h2>
        <p class="hq-desc reveal"><span class="i18n-zh">「据点」指我在互联网上的大本营：这个网站、我的 GitHub、B 站和抖音都属于这个据点群。下面是一张会动的太阳系示意图——第三轨道上的蓝色星球就是地球，我的据点就在那里。</span><span class="i18n-en">"Headquarter" means my base camp on the internet: this website, my GitHub, Bilibili and Douyin all belong to it. Below is a live solar system — the blue planet on the third orbit is Earth, and that's where my base sits.</span></p>
        <div class="hq-panel reveal" role="img" aria-label="太阳系动态示意图：太阳居中，行星沿轨道公转，地球位于第三轨道并标记为据点所在地">
          <canvas id="space-canvas" aria-hidden="true"></canvas>
          <div class="hq-tag"><span class="i18n-zh">YZBZGY · 网络据点</span><span class="i18n-en">YZBZGY · INTERNET HQ</span></div>
          <div class="hq-meta">
            <p><span class="i18n-zh">位置 — 地球 · 太阳系第三行星</span><span class="i18n-en">LOC — EARTH · 3RD PLANET</span></p>
            <p><span class="i18n-zh">状态 — 在线 · 自 {year}</span><span class="i18n-en">STATUS — ONLINE · EST. {year}</span></p>
            <p><span class="i18n-zh">更新 — 持续进行</span><span class="i18n-en">UPTIME — ONGOING</span></p>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="contact" id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title" class="reveal"><span class="i18n-zh">联系</span><span class="i18n-en">Contact</span></h2>
        <div class="contact-links reveal">
          <a href="https://github.com/zgy0715" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/></svg>
            <span>GITHUB</span>
          </a>
          <a href="https://github.com/zgy0715?tab=repositories" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 1.5A1.5 1.5 0 0 1 5.5 0h5A1.5 1.5 0 0 1 12 1.5v13a1.5 1.5 0 0 1-1.5 1.5h-5A1.5 1.5 0 0 1 4 14.5zM8 13a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5M1.5 3a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0v-6a.5.5 0 0 1 .5-.5m13 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/></svg>
            <span><span class="i18n-zh">全部仓库</span><span class="i18n-en">ALL REPOS</span></span>
          </a>
          <a href="https://space.bilibili.com/531846477" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 512 512" aria-hidden="true"><path d="M488.6 104.1c16.7 18.1 24.4 39.7 23.3 65.7v202.4c-.4 26.4-9.2 48.1-26.5 65.1c-17.2 17-39.1 25.9-65.5 26.7H92.02c-26.45-.8-48.21-9.8-65.28-27.2C9.682 419.4.767 396.5 0 368.2V169.8c.767-26 9.682-47.6 26.74-65.7C43.81 87.75 65.57 78.77 92.02 78h29.38L96.05 52.19c-5.75-5.73-8.63-13-8.63-21.79c0-8.8 2.88-16.06 8.63-21.797C101.8 2.868 109.1 0 117.9 0s16.1 2.868 21.9 8.603L213.1 78h88l74.5-69.397C381.7 2.868 389.2 0 398 0c8.8 0 16.1 2.868 21.9 8.603c5.7 5.737 8.6 12.997 8.6 21.797c0 8.79-2.9 16.06-8.6 21.79L394.6 78h29.3c26.4.77 48 9.75 64.7 26.1m-38.8 69.7c-.4-9.6-3.7-17.4-10.7-23.5c-5.2-6.1-14-9.4-22.7-9.8H96.05c-9.59.4-17.45 3.7-23.58 9.8c-6.14 6.1-9.4 13.9-9.78 23.5v194.4c0 9.2 3.26 17 9.78 23.5s14.38 9.8 23.58 9.8H416.4c9.2 0 17-3.3 23.3-9.8c6.3-6.5 9.7-14.3 10.1-23.5zm-264.3 42.7c6.3 6.3 9.7 14.1 10.1 23.2V273c-.4 9.2-3.7 16.9-9.8 23.2c-6.2 6.3-14 9.5-23.6 9.5c-9.6 0-17.5-3.2-23.6-9.5c-6.1-6.3-9.4-14-9.8-23.2v-33.3c.4-9.1 3.8-16.9 10.1-23.2c6.3-6.3 13.2-9.6 23.3-10c9.2.4 17 3.7 23.3 10m191.5 0c6.3 6.3 9.7 14.1 10.1 23.2V273c-.4 9.2-3.7 16.9-9.8 23.2c-6.1 6.3-14 9.5-23.6 9.5c-7-6.3-9.4-14-9.7-23.2v-33.3c.3-9.1 3.7-16.9 10-23.2c6.3-6.3 14.1-9.6 23.3-10c9.2.4 17 3.7 23.3 10"/></svg>
            <span>BILIBILI</span>
          </a>
          <a href="https://www.douyin.com/user/MS4wLjABAAAA6dxS4T4bSlZKc5WaiQ55DJ7IShZuouv5EeV2O--g-rx0Xb4fzwYARX1ngQdqkFh4" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 448 512" aria-hidden="true"><path d="M448,209.91a210.06,210.06,0,0,1-122.77-39.25V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0l88,0a121.18,121.18,0,0,0,1.86,22.17h0A122.18,122.18,0,0,0,381,102.39a121.43,121.43,0,0,0,67,20.14Z"/></svg>
            <span>DOUYIN</span>
          </a>
        </div>
        <footer><span class="i18n-zh">© {year} YZBZGY — 建于地球 · 见于线上</span><span class="i18n-en">© {year} YZBZGY — MADE ON EARTH · FOUND ONLINE</span></footer>
      </section>
    </main>

    <a class="top-button" id="top-button" href="#top" aria-label="回到顶部">↑</a>

    <script>
      // ===== 中 / EN 语言切换（默认中文，选择存入 localStorage）=====
      const rootHtml = document.documentElement;
      const langToggle = document.querySelector('#lang-toggle');
      const applyLang = (lang) => {
        rootHtml.classList.toggle('lang-en', lang === 'en');
        rootHtml.classList.toggle('lang-zh', lang !== 'en');
        rootHtml.lang = lang === 'en' ? 'en' : 'zh-CN';
        document.title = lang === 'en' ? 'YZBZGY · Personal Base' : 'YZBZGY · 个人据点';
        try { localStorage.setItem('site-lang', lang); } catch (e) {}
      };
      applyLang(rootHtml.classList.contains('lang-en') ? 'en' : 'zh');
      langToggle?.addEventListener('click', () => {
        applyLang(rootHtml.classList.contains('lang-en') ? 'zh' : 'en');
      });

      // ===== 明暗主题切换（记忆到 localStorage，首次跟随系统）=====
      const themeToggle = document.querySelector('#theme-toggle');
      const applyTheme = (theme) => {
        rootHtml.dataset.theme = theme;
        if (themeToggle) {
          themeToggle.textContent = theme === 'dark' ? '☀' : '☾';
          themeToggle.setAttribute('aria-label', theme === 'dark' ? '切换到浅色模式' : '切换到深色模式');
        }
        let themeMeta = document.querySelector('meta[name="theme-color"]');
        if (!themeMeta) {
          themeMeta = document.createElement('meta');
          themeMeta.name = 'theme-color';
          document.head.appendChild(themeMeta);
        }
        themeMeta.content = theme === 'dark' ? '#0a0a0a' : '#3388bb';
        try { localStorage.setItem('site-theme', theme); } catch (e) {}
      };
      applyTheme(rootHtml.dataset.theme === 'dark' ? 'dark' : 'light');
      themeToggle?.addEventListener('click', () => {
        applyTheme(rootHtml.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      // ===== 全屏菜单 =====
      const menu = document.querySelector('#menu');
      const menuOpen = document.querySelector('#menu-open');
      const menuClose = document.querySelector('#menu-close');
      const menuLinks = [...(menu?.querySelectorAll('a') ?? [])];
      const setMenuOpen = (open) => {
        menu?.classList.toggle('open', open);
        menu?.setAttribute('aria-hidden', String(!open));
        if (menu) menu.inert = !open;
        menuOpen?.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('menu-open', open);
        if (open) menuClose?.focus();
        else menuOpen?.focus();
      };
      menuOpen?.addEventListener('click', () => setMenuOpen(true));
      menuClose?.addEventListener('click', () => setMenuOpen(false));
      menuLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.classList.contains('open')) setMenuOpen(false);
        if (event.key === 'Tab' && menu?.classList.contains('open')) {
          const focusables = [menuClose, ...menuLinks].filter(Boolean);
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
        }
      });

      // ===== 顶部栏：下滑隐藏、上滑出现 =====
      const topbar = document.querySelector('#topbar');
      let lastY = window.scrollY;
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        if (topbar) {
          if (y > lastY + 6 && y > 140 && !document.body.classList.contains('menu-open')) topbar.classList.add('hidden');
          else if (y < lastY - 6 || y <= 140) topbar.classList.remove('hidden');
        }
        lastY = y;
      }, { passive: true });

      // ===== 兴趣文字流：滚动驱动横向位移 =====
      const flowSection = document.querySelector('.flow-section');
      const flowTrack = document.querySelector('#flow-track');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const updateFlow = () => {
        if (!flowSection || !flowTrack || reducedMotion) return;
        const rect = flowSection.getBoundingClientRect();
        const scrollable = flowSection.offsetHeight - window.innerHeight;
        if (scrollable <= 0) return;
        const progress = Math.min(1, Math.max(0, -rect.top / scrollable));
        const distance = Math.max(0, flowTrack.scrollWidth - window.innerWidth + window.innerWidth * 0.08);
        flowTrack.style.transform = `translateX(${-progress * distance}px)`;
      };
      window.addEventListener('scroll', updateFlow, { passive: true });
      window.addEventListener('resize', updateFlow);
      updateFlow();

      // ===== 项目轮播 =====
      const slider = document.querySelector('#slider');
      const dotsBox = document.querySelector('#dots');
      const slides = [...(slider?.querySelectorAll('.slide') ?? [])];
      const step = () => (slides[0] ? slides[0].getBoundingClientRect().width + 24 : slider?.clientWidth ?? 300);
      slides.forEach((_, index) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', `第 ${index + 1} 个项目`);
        dot.addEventListener('click', () => slider?.scrollTo({ left: index * step(), behavior: 'smooth' }));
        dotsBox?.appendChild(dot);
      });
      const dots = [...(dotsBox?.querySelectorAll('button') ?? [])];
      const updateDots = () => {
        if (!slider) return;
        const index = Math.min(slides.length - 1, Math.round(slider.scrollLeft / step()));
        dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
      };
      slider?.addEventListener('scroll', updateDots, { passive: true });
      updateDots();
      document.querySelector('#slider-prev')?.addEventListener('click', () => slider?.scrollBy({ left: -step(), behavior: 'smooth' }));
      document.querySelector('#slider-next')?.addEventListener('click', () => slider?.scrollBy({ left: step(), behavior: 'smooth' }));

      // ===== 回到顶部 =====
      const topButton = document.querySelector('#top-button');
      const updateTopButton = () => topButton?.classList.toggle('visible', window.scrollY > window.innerHeight * 0.8);
      window.addEventListener('scroll', updateTopButton, { passive: true });
      updateTopButton();

      // ===== 进场动画 =====
      const revealElements = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !reducedMotion) {
        const revealObserver = new IntersectionObserver((entries, observer) => entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
        }), { threshold: .1 });
        revealElements.forEach((element) => revealObserver.observe(element));
      } else {
        revealElements.forEach((element) => element.classList.add('visible'));
      }

      // ===== 太阳系（Canvas 渲染）：地球在第三轨道，标记为据点 =====
      const spaceCanvas = document.querySelector('#space-canvas');
      if (spaceCanvas) {
        const sctx = spaceCanvas.getContext('2d');
        const STAR_COUNT = 130;
        const stars = Array.from({ length: STAR_COUNT }, () => ({
          x: Math.random(), y: Math.random(), r: Math.random() * 1.1 + .3, tw: Math.random() * Math.PI * 2,
        }));
        // orbit: 相对面板短边的半径比例；period: 相对地球公转周期的倍数（开普勒近似）
        const planets = [
          { name: 'MERCURY', orbit: .16, size: 2.4, period: .24, color: '#9aa0a6' },
          { name: 'VENUS',   orbit: .26, size: 3.8, period: .62, color: '#d9b38c' },
          { name: 'EARTH',   orbit: .40, size: 6.0, period: 1,   color: '#3388bb', hq: true },
          { name: 'MARS',    orbit: .52, size: 3.4, period: 1.88, color: '#c96a4a' },
          { name: 'JUPITER', orbit: .68, size: 9.0, period: 4.5, color: '#cfa678' },
          { name: 'SATURN',  orbit: .86, size: 7.6, period: 7.4, color: '#d8c690', ring: true },
        ].map((p, i) => ({ ...p, ang: i * 1.7 }));
        const EARTH_YEAR_MS = 24000; // 地球公转一圈 24 秒
        let panelW = 0, panelH = 0;
        const resizeSpace = () => {
          const dpr = window.devicePixelRatio || 1;
          const rect = spaceCanvas.getBoundingClientRect();
          panelW = rect.width; panelH = rect.height;
          spaceCanvas.width = panelW * dpr;
          spaceCanvas.height = panelH * dpr;
          sctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resizeSpace();
        window.addEventListener('resize', resizeSpace);
        const drawSpace = (t) => {
          const cx = panelW / 2, cy = panelH / 2;
          const unit = Math.min(panelW, panelH) * .47;
          sctx.clearRect(0, 0, panelW, panelH);
          // 星空（缓慢闪烁）
          for (const s of stars) {
            sctx.globalAlpha = .25 + .5 * Math.abs(Math.sin(t * .0004 + s.tw));
            sctx.fillStyle = '#fff';
            sctx.beginPath();
            sctx.arc(s.x * panelW, s.y * panelH, s.r, 0, Math.PI * 2);
            sctx.fill();
          }
          sctx.globalAlpha = 1;
          // 太阳（暖色光晕）
          const sunR = Math.max(9, unit * .07);
          const glow = sctx.createRadialGradient(cx, cy, 0, cx, cy, sunR * 3.2);
          glow.addColorStop(0, 'rgba(255, 210, 140, .85)');
          glow.addColorStop(.35, 'rgba(255, 170, 90, .25)');
          glow.addColorStop(1, 'rgba(255, 170, 90, 0)');
          sctx.fillStyle = glow;
          sctx.beginPath();
          sctx.arc(cx, cy, sunR * 3.2, 0, Math.PI * 2);
          sctx.fill();
          sctx.fillStyle = '#ffdca8';
          sctx.beginPath();
          sctx.arc(cx, cy, sunR, 0, Math.PI * 2);
          sctx.fill();
          // 行星
          for (const p of planets) {
            const orbitR = unit * p.orbit;
            sctx.strokeStyle = 'rgba(255, 255, 255, .10)';
            sctx.lineWidth = 1;
            sctx.beginPath();
            sctx.arc(cx, cy, orbitR, 0, Math.PI * 2);
            sctx.stroke();
            const ang = p.ang + (t / (EARTH_YEAR_MS * p.period)) * Math.PI * 2;
            const x = cx + Math.cos(ang) * orbitR;
            const y = cy + Math.sin(ang) * orbitR * .96; // 轻微压扁，透视感
            if (p.ring) { // 土星环
              sctx.strokeStyle = 'rgba(216, 198, 144, .55)';
              sctx.beginPath();
              sctx.ellipse(x, y, p.size * 2.1, p.size * .8, ang, 0, Math.PI * 2);
              sctx.stroke();
            }
            if (p.hq) { // 地球：蓝色光晕 + 据点标记
              sctx.shadowColor = '#3388bb';
              sctx.shadowBlur = 18;
              sctx.fillStyle = '#3f97cc';
              sctx.beginPath();
              sctx.arc(x, y, p.size, 0, Math.PI * 2);
              sctx.fill();
              sctx.shadowBlur = 0;
              sctx.fillStyle = 'rgba(255, 255, 255, .55)';
              sctx.beginPath();
              sctx.arc(x - p.size * .3, y - p.size * .3, p.size * .32, 0, Math.PI * 2);
              sctx.fill(); // 高光
              const moonAng = ang * 13.4; // 月球：一年约 13.4 个朔望月
              const moonR = p.size * 2.6;
              sctx.fillStyle = '#c7c9cc';
              sctx.beginPath();
              sctx.arc(x + Math.cos(moonAng) * moonR, y + Math.sin(moonAng) * moonR, 1.8, 0, Math.PI * 2);
              sctx.fill();
              // 据点标记环（古铜金虚线）+ 标签
              sctx.strokeStyle = '#bb9955';
              sctx.setLineDash([3, 4]);
              sctx.beginPath();
              sctx.arc(x, y, p.size + 7, 0, Math.PI * 2);
              sctx.stroke();
              sctx.setLineDash([]);
              sctx.fillStyle = 'rgba(255, 255, 255, .75)';
              sctx.font = '8px ui-monospace, Menlo, monospace';
              sctx.textAlign = 'center';
              sctx.fillText('EARTH · HQ', x, y + p.size + 20);
            } else {
              sctx.fillStyle = p.color;
              sctx.beginPath();
              sctx.arc(x, y, p.size, 0, Math.PI * 2);
              sctx.fill();
            }
          }
        };
        let spaceRunning = false, spaceRafId = 0;
        const spaceLoop = (t) => {
          drawSpace(t);
          if (spaceRunning) spaceRafId = requestAnimationFrame(spaceLoop);
        };
        const setSpaceRunning = (run) => {
          if (run && !spaceRunning) {
            spaceRunning = true;
            spaceRafId = requestAnimationFrame(spaceLoop);
          } else if (!run && spaceRunning) {
            spaceRunning = false;
            cancelAnimationFrame(spaceRafId);
          }
        };
        if (reducedMotion) {
          drawSpace(0); // 静态帧
        } else {
          // 面板滚出视口时暂停动画，省电
          if ('IntersectionObserver' in window) {
            new IntersectionObserver((entries) => setSpaceRunning(entries[0].isIntersecting), { threshold: .05 })
              .observe(spaceCanvas);
          } else {
            setSpaceRunning(true);
          }
        }
      }

      // ===== 背景音效（默认关闭）=====
      const sound = document.querySelector('#sound');
      let audioContext;
      let voices = [];
      sound?.addEventListener('click', async () => {
        const enabled = sound.getAttribute('aria-pressed') !== 'true';
        if (enabled) {
          audioContext ??= new AudioContext();
          if (audioContext.state === 'suspended') await audioContext.resume();
          voices = [110, 164.81, 220].map((frequency, index) => {
            const oscillator = audioContext.createOscillator();
            const volume = audioContext.createGain();
            oscillator.type = index === 1 ? 'triangle' : 'sine';
            oscillator.frequency.value = frequency;
            volume.gain.value = 0.004;
            oscillator.connect(volume).connect(audioContext.destination);
            oscillator.start();
            return { oscillator, volume };
          });
        } else {
          voices.forEach(({ oscillator, volume }) => {
            volume.gain.setTargetAtTime(0, audioContext.currentTime, .08);
            oscillator.stop(audioContext.currentTime + .35);
          });
          voices = [];
        }
        sound.setAttribute('aria-pressed', String(enabled));
        sound.setAttribute('aria-label', enabled ? '关闭背景音效' : '开启背景音效');
      });
    </script>
  </body>
</html>
