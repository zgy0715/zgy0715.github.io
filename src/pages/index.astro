// ===== 构建期拉取各仓库真实 star / commit / 最近推送（GitHub API，失败则该卡片不显示统计行）=====
async function fetchRepoStats(fullName) {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 5000);
  try {
    const headers = { Accept: 'application/vnd.github+json', 'User-Agent': 'yzbzgy-site-build' };
    const base = `https://api.github.com/repos/${fullName}`;
    const [repoRes, commitRes] = await Promise.all([
      fetch(base, { headers, signal: ctrl.signal }),
      fetch(`${base}/commits?per_page=1`, { headers, signal: ctrl.signal }),
    ]);
    if (!repoRes.ok) return null;
    const repo = await repoRes.json();
    const link = commitRes.headers.get('link') || '';
    const last = /page=(\d+)>;\s*rel="last"/.exec(link);
    return {
      stars: repo.stargazers_count,
      commits: last ? Number(last[1]) : commitRes.ok ? 1 : null,
      pushed: repo.pushed_at ? repo.pushed_at.slice(0, 10).replace(/-/g, '.') : null,
    };
  } catch {
    return null;
  } finally {
    clearTimeout(timer);
  }
}
const repoStats = Object.fromEntries(await Promise.all(
  projects
    .filter((p) => p.href?.startsWith('https://github.com/'))
    .map(async (p) => [p.number, await fetchRepoStats(p.href.replace('https://github.com/', '').replace(/\/$/, ''))])
));
