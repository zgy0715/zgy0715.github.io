    <script>
      // ===== 中 / EN 语言切换（默认中文，选择存入 localStorage）=====
      const rootHtml = document.documentElement;
      const langToggle = document.querySelector('#lang-toggle');
      const applyLang = (lang) => {
        rootHtml.classList.toggle('lang-en', lang === 'en');
        rootHtml.classList.toggle('lang-zh', lang !== 'en');
        rootHtml.lang = lang === 'en' ? 'en' : 'zh-CN';
        document.title = lang === 'en' ? 'YZBZGY · Personal Base' : 'YZBZGY · 个人据点';
        try { localStorage.setItem('site-lang', lang); } catch (e) {}
      };
      applyLang(rootHtml.classList.contains('lang-en') ? 'en' : 'zh');
      langToggle?.addEventListener('click', () => {
        applyLang(rootHtml.classList.contains('lang-en') ? 'zh' : 'en');
      });

      // ===== 明暗主题切换（记忆到 localStorage，首次跟随系统）=====
      const themeToggle = document.querySelector('#theme-toggle');
      const applyTheme = (theme) => {
        rootHtml.dataset.theme = theme;
        if (themeToggle) {
          themeToggle.textContent = theme === 'dark' ? '☀' : '☾';
          themeToggle.setAttribute('aria-label', theme === 'dark' ? '切换到浅色模式' : '切换到深色模式');
        }
        let themeMeta = document.querySelector('meta[name="theme-color"]');
        if (!themeMeta) {
          themeMeta = document.createElement('meta');
          themeMeta.name = 'theme-color';
          document.head.appendChild(themeMeta);
        }
        themeMeta.content = theme === 'dark' ? '#0a0a0a' : '#3388bb';
        try { localStorage.setItem('site-theme', theme); } catch (e) {}
      };
      applyTheme(rootHtml.dataset.theme === 'dark' ? 'dark' : 'light');
      themeToggle?.addEventListener('click', () => {
        applyTheme(rootHtml.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      // ===== 展开更多项目 =====
      const projectsToggle = document.querySelector('#projects-toggle');
      const projectCards = [...(document.querySelectorAll('.project-card') ?? [])];
      projectsToggle?.addEventListener('click', () => {
        const expanded = projectsToggle.getAttribute('aria-expanded') !== 'true';
        projectCards.forEach((card, index) => {
          if (index >= 3) card.hidden = !expanded;
        });
        projectsToggle.setAttribute('aria-expanded', String(expanded));
        projectsToggle.querySelectorAll('[data-collapsed]').forEach((label) => {
          label.textContent = label.dataset[expanded ? 'expanded' : 'collapsed'];
        });
      });

      // ===== 右侧抽屉菜单 =====
      const menu = document.querySelector('#menu');
      const menuOpen = document.querySelector('#menu-open');
      const menuClose = document.querySelector('#menu-close');
      const menuBackdrop = document.querySelector('#menu-backdrop');
      const menuLinks = [...(menu?.querySelectorAll('a') ?? [])];
      const setMenuOpen = (open) => {
        menu?.classList.toggle('open', open);
        menuBackdrop?.classList.toggle('open', open);
        menu?.setAttribute('aria-hidden', String(!open));
        if (menu) menu.inert = !open;
        menuOpen?.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('menu-open', open);
        if (open) menuClose?.focus();
        else menuOpen?.focus();
      };
      menuOpen?.addEventListener('click', () => setMenuOpen(true));
      menuClose?.addEventListener('click', () => setMenuOpen(false));
      menuBackdrop?.addEventListener('click', () => setMenuOpen(false));
      menuLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.classList.contains('open')) setMenuOpen(false);
        if (event.key === 'Tab' && menu?.classList.contains('open')) {
          const focusables = [menuClose, ...menuLinks].filter(Boolean);
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
        }
      });

      // ===== 顶部栏：下滑隐藏、上滑出现 =====
      const topbar = document.querySelector('#topbar');
      const topButton = document.querySelector('#top-button');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let lastY = window.scrollY;
      let scrollFrame = 0;
      const updateScrollState = () => {
        scrollFrame = 0;
        const y = window.scrollY;
        if (topbar) {
          topbar.classList.toggle('scrolled', y > 40);
          if (y > lastY + 6 && y > 140 && !document.body.classList.contains('menu-open')) topbar.classList.add('hidden');
          else if (y < lastY - 6 || y <= 140) topbar.classList.remove('hidden');
        }
        topButton?.classList.toggle('visible', y > window.innerHeight * 0.8);
        lastY = y;
      };
      const scheduleScrollUpdate = () => {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(updateScrollState);
      };
      window.addEventListener('scroll', scheduleScrollUpdate, { passive: true });
      window.addEventListener('resize', () => {
        scheduleScrollUpdate();
      }, { passive: true });
      scheduleScrollUpdate();

      document.fonts?.ready.then(() => {
        scheduleScrollUpdate();
      });

      // ===== 进场动画 =====
      const revealElements = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !reducedMotion) {
        const revealObserver = new IntersectionObserver((entries, observer) => entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
        }), { threshold: .1 });
        revealElements.forEach((element) => revealObserver.observe(element));
      } else {
        revealElements.forEach((element) => element.classList.add('visible'));
      }

      // ===== 太阳系（Canvas 写实渲染）：真实行星贴图 + 太阳光照晨昏线 + 小行星带 + 彗星 =====
      const spaceCanvas = document.querySelector('#space-canvas');
      if (spaceCanvas) {
        const sctx = spaceCanvas.getContext('2d');
        const TAU = Math.PI * 2;
        const EARTH_YEAR_MS = 24000; // 地球公转一圈 24 秒
        // 固定随机种子：resize 后星空/小行星带保持同一布局
        const rand = ((seed) => () => (seed = (seed * 16807) % 2147483647) / 2147483647)(20261022);

        // orbit: 相对面板短边的半径比例（外行星显著拉开，防贴图重叠）；
        // period: 相对地球公转周期的倍数（开普勒近似）；tilt: 各行星轨道面的压扁系数微差（伪 3D）
        const planets = [
          { name: 'MERCURY', orbit: .14, size: 3.2,  period: .24 },
          { name: 'VENUS',   orbit: .24, size: 5.2,  period: .62 },
          { name: 'EARTH',   orbit: .35, size: 5.8,  period: 1,    hq: true },
          { name: 'MARS',    orbit: .46, size: 4.4,  period: 1.88 },
          { name: 'JUPITER', orbit: .60, size: 13.5, period: 4.5 },
          { name: 'SATURN',  orbit: .75, size: 11.5, period: 7.4, ring: true },
          { name: 'URANUS',  orbit: .88, size: 7.6,  period: 12 },
          { name: 'NEPTUNE', orbit: 1.0, size: 7.2,  period: 16 },
        ].map((p, i) => ({ ...p, ang: i * 1.7 + .6, tilt: .5 + rand() * .1 }));

        // 小行星带（火星与木星之间）与彗星
        const belt = Array.from({ length: 150 }, () => ({
          orbit: .515 + rand() * .05, ang: rand() * TAU,
          period: 3.3 + rand() * 1.2, r: .4 + rand() * .8, a: .22 + rand() * .4, tilt: .5 + rand() * .08,
        }));
        const comet = { a: .82, e: .68, tilt: -.42, period: 5.4, squash: .55 };

        // 星空：静态底 + 动态闪烁两层
        const stars = Array.from({ length: 130 }, () => ({
          x: rand(), y: rand(), r: rand() * 1.05 + .3, tw: rand() * TAU,
          sp: .6 + rand() * 1.1, sa: .12 + rand() * .22, c: rand() < .78 ? '255,255,255' : rand() < .5 ? '190,214,255' : '255,219,178',
        }));

        let panelW = 0, panelH = 0, unit = 0, scale = 1;

        // ---- 行星贴图：离屏预渲染（不含晨昏线阴影，阴影在主画布按太阳方位叠加）----
        const sprites = new Map();
        const makeSprite = (r, paint) => {
          const pad = 4;
          const c = document.createElement('canvas');
          c.width = c.height = Math.ceil((r + pad) * 2);
          const g = c.getContext('2d');
          g.translate(c.width / 2, c.height / 2);
          paint(g, r);
          return c;
        };
        const shadeBody = (g, r, stops) => { // 球面基础明暗（左上受光）
          const base = g.createRadialGradient(-r * .38, -r * .38, r * .1, 0, 0, r * 1.15);
          for (const [o, c] of stops) base.addColorStop(o, c);
          g.fillStyle = base;
          g.beginPath();
          g.arc(0, 0, r, 0, TAU);
          g.fill();
        };
        const painters = {
          MERCURY: (g, r) => {
            shadeBody(g, r, [[0, '#b9b3a8'], [.55, '#8f8a80'], [1, '#5c584f']]);
            for (let i = 0; i < 7; i++) { // 陨石坑
              const a = rand() * TAU, d = rand() * r * .72, cr = r * (.08 + rand() * .12);
              g.fillStyle = `rgba(70,66,60,${.25 + rand() * .25})`;
              g.beginPath();
              g.arc(Math.cos(a) * d, Math.sin(a) * d, cr, 0, TAU);
              g.fill();
            }
          },
          VENUS: (g, r) => {
            shadeBody(g, r, [[0, '#f3e2b8'], [.55, '#dbba85'], [1, '#a9834f']]);
            for (let i = 0; i < 5; i++) { // 硫酸云带
              g.strokeStyle = `rgba(255,244,214,${.14 + rand() * .12})`;
              g.lineWidth = r * (.12 + rand() * .1);
              g.beginPath();
              g.arc(rand() * r * .3 - r * .15, (i - 2) * r * .34, r * (.55 + rand() * .3), Math.PI * .15, Math.PI * .85);
              g.stroke();
            }
          },
          EARTH: (g, r) => {
            shadeBody(g, r, [[0, '#7db8dd'], [.5, '#3c7fb4'], [1, '#1c4a77']]);
            for (let i = 0; i < 6; i++) { // 陆地板块
              const a = rand() * TAU, d = rand() * r * .6;
              g.fillStyle = `rgba(96,150,88,${.75 + rand() * .2})`;
              g.beginPath();
              g.ellipse(Math.cos(a) * d, Math.sin(a) * d, r * (.2 + rand() * .22), r * (.12 + rand() * .16), rand() * TAU, 0, TAU);
              g.fill();
            }
            for (let i = 0; i < 7; i++) { // 云层
              g.fillStyle = `rgba(255,255,255,${.28 + rand() * .26})`;
              g.beginPath();
              g.ellipse((rand() - .5) * r * 1.2, (rand() - .5) * r * 1.3, r * (.16 + rand() * .2), r * (.07 + rand() * .1), rand() * TAU, 0, TAU);
              g.fill();
            }
          },
          MARS: (g, r) => {
            shadeBody(g, r, [[0, '#e08a5c'], [.55, '#c25f38'], [1, '#7c3520']]);
            g.fillStyle = 'rgba(120,52,30,.5)'; // 暗色地貌
            g.beginPath();
            g.ellipse(-r * .2, r * .28, r * .42, r * .16, .4, 0, TAU);
            g.fill();
            g.fillStyle = 'rgba(255,245,235,.8)'; // 极冠
            g.beginPath();
            g.ellipse(0, -r * .82, r * .3, r * .12, 0, 0, TAU);
            g.fill();
          },
          JUPITER: (g, r) => { // 条纹带 + 大红斑
            const bands = ['#e8d9b8', '#c9a97c', '#a97e52', '#e3cfa8', '#b98d5e', '#d9c39a', '#a3764a', '#e0cda9'];
            g.save();
            g.beginPath();
            g.arc(0, 0, r, 0, TAU);
            g.clip();
            const bh = (r * 2) / bands.length;
            bands.forEach((c, i) => {
              g.fillStyle = c;
              g.fillRect(-r, -r + i * bh, r * 2, bh + 1);
            });
            g.fillStyle = 'rgba(196,90,58,.85)'; // 大红斑
            g.beginPath();
            g.ellipse(r * .34, r * .3, r * .26, r * .14, -.1, 0, TAU);
            g.fill();
            g.fillStyle = 'rgba(255,240,220,.2)';
            g.beginPath();
            g.ellipse(-r * .3, -r * .45, r * .5, r * .3, 0, 0, TAU);
            g.fill();
            g.restore();
            const glow = g.createRadialGradient(-r * .3, -r * .3, r * .2, 0, 0, r * 1.12);
            glow.addColorStop(0, 'rgba(255,250,240,.16)');
            glow.addColorStop(1, 'rgba(20,16,10,.28)');
            g.fillStyle = glow;
            g.beginPath();
            g.arc(0, 0, r, 0, TAU);
            g.fill();
          },
          SATURN: (g, r) => {
            const bands = ['#efe3c0', '#d9c79a', '#c4ad7c', '#e6d8b2', '#cdb98a', '#d9c99e'];
            g.save();
            g.beginPath();
            g.arc(0, 0, r, 0, TAU);
            g.clip();
            const bh = (r * 2) / bands.length;
            bands.forEach((c, i) => {
              g.fillStyle = c;
              g.fillRect(-r, -r + i * bh, r * 2, bh + 1);
            });
            g.restore();
            const glow = g.createRadialGradient(-r * .3, -r * .3, r * .2, 0, 0, r * 1.12);
            glow.addColorStop(0, 'rgba(255,250,238,.15)');
            glow.addColorStop(1, 'rgba(22,18,10,.26)');
            g.fillStyle = glow;
            g.beginPath();
            g.arc(0, 0, r, 0, TAU);
            g.fill();
          },
          URANUS: (g, r) => {
            shadeBody(g, r, [[0, '#c8ecf2'], [.55, '#93cfda'], [1, '#4f93a5']]);
          },
          NEPTUNE: (g, r) => {
            shadeBody(g, r, [[0, '#6f9ee8'], [.55, '#3f6cc4'], [1, '#1d3a7e']]);
            g.fillStyle = 'rgba(18,32,74,.55)'; // 大暗斑
            g.beginPath();
            g.ellipse(r * .18, -r * .2, r * .26, r * .14, .2, 0, TAU);
            g.fill();
            g.fillStyle = 'rgba(240,250,255,.5)'; // 云丝
            g.beginPath();
            g.ellipse(-r * .25, r * .3, r * .22, r * .05, -.15, 0, TAU);
            g.fill();
          },
        };
        const buildSprites = () => {
          for (const p of planets) {
            sprites.set(p.name, makeSprite(p.size * scale, painters[p.name]));
          }
        };

        // 土星环：后半在行星后，前半在行星前（固定倾角，不随公转旋转）
        const RING_TILT = -.46;
        const drawRingHalf = (x, y, r, front) => {
          const rings = [
            [1.45, 1.95, 'rgba(216,200,160,.34)'],
            [1.98, 2.18, 'rgba(228,214,178,.6)'],
            [2.2, 2.3, 'rgba(200,184,146,.3)'],
          ];
          for (const [r0, r1, c] of rings) {
            sctx.strokeStyle = c;
            sctx.lineWidth = (r1 - r0) * r;
            sctx.beginPath();
            sctx.ellipse(x, y, r * (r0 + r1) / 2, r * (r0 + r1) / 2 * .36, RING_TILT, front ? 0 : Math.PI, front ? Math.PI : TAU);
            sctx.stroke();
          }
        };

        // 晨昏线：朝向太阳一侧亮、背面渐暗（写实的关键）
        const drawTerminator = (x, y, r) => {
          const lightAng = Math.atan2(panelH / 2 - y, panelW / 2 - x);
          sctx.save();
          sctx.beginPath();
          sctx.arc(x, y, r + .6, 0, TAU);
          sctx.clip();
          sctx.translate(x, y);
          sctx.rotate(lightAng);
          const g = sctx.createLinearGradient(r * .3, 0, -r, 0);
          g.addColorStop(0, 'rgba(6,9,16,0)');
          g.addColorStop(.52, 'rgba(6,9,16,.1)');
          g.addColorStop(1, 'rgba(6,9,16,.74)');
          sctx.fillStyle = g;
          sctx.fillRect(-r - 2, -r - 2, r * 2 + 4, r * 2 + 4);
          sctx.restore();
        };

        let mouseX = -1, mouseY = -1;
        let hoveredPlanet = null, selectedPlanet = null, lastPositions = [];
        let showerUntil = 0;
        const meteors = Array.from({ length: 9 }, () => ({ x: 0, y: 0, vx: 0, vy: 0, born: 0, ttl: 1 }));
        spaceCanvas.addEventListener('mousemove', (e) => {
          const rect = spaceCanvas.getBoundingClientRect();
          mouseX = e.clientX - rect.left;
          mouseY = e.clientY - rect.top;
        }, { passive: true });
        spaceCanvas.addEventListener('mouseleave', () => { mouseX = mouseY = -1; }, { passive: true });

        const resizeSpace = () => {
          const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
          const rect = spaceCanvas.getBoundingClientRect();
          if (rect.width === panelW && rect.height === panelH
            && spaceCanvas.width === Math.round(rect.width * dpr)
            && spaceCanvas.height === Math.round(rect.height * dpr)) return;
          panelW = rect.width; panelH = rect.height;
          spaceCanvas.width = Math.round(panelW * dpr);
          spaceCanvas.height = Math.round(panelH * dpr);
          sctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          unit = Math.min(panelW, panelH) * .47;
          scale = Math.max(.8, Math.min(1.35, unit / 220));
          buildSprites();
        };
        resizeSpace();

        const drawSpace = (t) => {
          const cx = panelW / 2, cy = panelH / 2;
          const realNow = performance.now();
          sctx.clearRect(0, 0, panelW, panelH);
          // 静态星空 + 银河尘带
          for (const s of stars) {
            sctx.globalAlpha = s.sa;
            sctx.fillStyle = `rgb(${s.c})`;
            sctx.beginPath();
            sctx.arc(s.x * panelW, s.y * panelH, s.r, 0, TAU);
            sctx.fill();
          }
          const haze = sctx.createLinearGradient(0, panelH * .8, panelW, panelH * .15);
          haze.addColorStop(0, 'rgba(96,116,180,0)');
          haze.addColorStop(.5, 'rgba(96,116,180,.05)');
          haze.addColorStop(1, 'rgba(96,116,180,0)');
          sctx.fillStyle = haze;
          sctx.fillRect(0, 0, panelW, panelH);
          // 闪烁星
          for (const s of stars) {
            if (s.r < 1) continue;
            sctx.globalAlpha = .1 + .55 * Math.abs(Math.sin(t * .0005 * s.sp + s.tw));
            sctx.fillStyle = `rgb(${s.c})`;
            sctx.beginPath();
            sctx.arc(s.x * panelW, s.y * panelH, s.r * .9, 0, TAU);
            sctx.fill();
          }
          sctx.globalAlpha = 1;
          // 轨道（各自压扁的椭圆；悬停/选中的行星轨道加亮）
          for (const p of planets) {
            const orbitR = unit * p.orbit;
            const hi = p === hoveredPlanet || p === selectedPlanet;
            sctx.strokeStyle = p.hq
              ? (hi ? 'rgba(120,190,240,.6)' : 'rgba(92, 168, 224, .3)')
              : (hi ? 'rgba(255,255,255,.4)' : 'rgba(255, 255, 255, .085)');
            sctx.lineWidth = hi ? 1.6 : 1;
            sctx.beginPath();
            sctx.ellipse(cx, cy, orbitR, orbitR * p.tilt, 0, 0, TAU);
            sctx.stroke();
          }
          // 小行星带
          for (const a of belt) {
            const aa = a.ang + (t / (EARTH_YEAR_MS * a.period)) * TAU;
            sctx.globalAlpha = a.a;
            sctx.fillStyle = '#9a948a';
            sctx.beginPath();
            sctx.arc(cx + Math.cos(aa) * unit * a.orbit, cy + Math.sin(aa) * unit * a.orbit * a.tilt, a.r * scale, 0, TAU);
            sctx.fill();
          }
          sctx.globalAlpha = 1;
          // ---- 本帧行星 / 彗星位置（伪 3D：y 压扁，y < cy 视为太阳远侧）----
          const positions = planets.map((p) => {
            const orbitR = unit * p.orbit;
            const ang = p.ang + (t / (EARTH_YEAR_MS * p.period)) * TAU;
            return { p, ang, r: p.size * scale, x: cx + Math.cos(ang) * orbitR, y: cy + Math.sin(ang) * orbitR * p.tilt };
          });
          lastPositions = positions;
          const M = (t / (EARTH_YEAR_MS * comet.period)) * TAU;
          const rC = (comet.a * (1 - comet.e * comet.e)) / (1 + comet.e * Math.cos(M));
          const cometPos = { x: cx + Math.cos(M + comet.tilt) * unit * rC, y: cy + Math.sin(M + comet.tilt) * unit * rC * comet.squash, rC };

          const drawPlanet = (it) => {
            const { p, ang, r, x, y } = it;
            if (p.ring) drawRingHalf(x, y, r, false);
            const sp = sprites.get(p.name);
            sctx.drawImage(sp, x - sp.width / 2, y - sp.height / 2);
            drawTerminator(x, y, r);
            if (p.ring) drawRingHalf(x, y, r, true);
            if (p.hq) { // 地球：月球
              const moonAng = ang * 13.4;
              const moonR = r * 2.7;
              sctx.fillStyle = '#c7c9cc';
              sctx.beginPath();
              sctx.arc(x + Math.cos(moonAng) * moonR, y + Math.sin(moonAng) * moonR, 1.9 * scale, 0, TAU);
              sctx.fill();
            }
            if (p.hq || p === selectedPlanet) { // 据点标记环 / 选中环（古铜金虚线）
              sctx.strokeStyle = '#bb9955';
              sctx.setLineDash([3, 4]);
              sctx.beginPath();
              sctx.arc(x, y, r + 9 * scale, 0, TAU);
              sctx.stroke();
              sctx.setLineDash([]);
            }
            if (p.hq) {
              sctx.fillStyle = 'rgba(255, 255, 255, .78)';
              sctx.font = `600 ${Math.max(9, 10 * scale)}px ui-monospace, Menlo, monospace`;
              sctx.textAlign = 'center';
              sctx.shadowColor = 'rgba(5, 7, 13, .9)';
              sctx.shadowBlur = 5;
              sctx.fillText('EARTH · HQ', x, y + r + 25 * scale);
              sctx.shadowBlur = 0;
            }
          };

          const drawComet = () => {
            const { x: px, y: py, rC: rc } = cometPos;
            const per = Math.max(0, 1 - rc / (comet.a * .5)); // 近日点因子：日距小于 a/2 后逐渐拉满
            const tailLen = Math.max(0, (1 - rc / comet.a) * (150 + 130 * per) * scale);
            if (tailLen > 14) {
              const away = Math.atan2(py - cy, px - cx);
              const tg = sctx.createLinearGradient(px, py, px + Math.cos(away) * tailLen, py + Math.sin(away) * tailLen);
              tg.addColorStop(0, `rgba(210, 234, 255, ${.5 + .4 * per})`);
              tg.addColorStop(1, 'rgba(170, 220, 255, 0)');
              sctx.strokeStyle = tg;
              sctx.lineWidth = (2.2 + 1.5 * per) * scale;
              sctx.beginPath();
              sctx.moveTo(px, py);
              sctx.lineTo(px + Math.cos(away) * tailLen, py + Math.sin(away) * tailLen);
              sctx.stroke();
            }
            if (per > .08) { // 近日点光晕
              const halo = sctx.createRadialGradient(px, py, 0, px, py, 15 * scale);
              halo.addColorStop(0, `rgba(190, 228, 255, ${.45 * per})`);
              halo.addColorStop(1, 'rgba(190, 228, 255, 0)');
              sctx.fillStyle = halo;
              sctx.beginPath();
              sctx.arc(px, py, 15 * scale, 0, TAU);
              sctx.fill();
            }
            sctx.fillStyle = 'rgba(210, 236, 255, .95)';
            sctx.beginPath();
            sctx.arc(px, py, (1.6 + .9 * per) * scale, 0, TAU);
            sctx.fill();
            const labelAlpha = Math.max(0, Math.min(1, (per - .3) / .25)); // 近日点标签淡入淡出
            if (labelAlpha > 0) {
              const en = document.documentElement.classList.contains('lang-en');
              sctx.globalAlpha = labelAlpha;
              sctx.fillStyle = 'rgba(255, 255, 255, .85)';
              sctx.font = `600 ${Math.max(9, 9.5 * scale)}px ui-monospace, Menlo, monospace`;
              sctx.textAlign = 'center';
              sctx.shadowColor = 'rgba(5, 7, 13, .9)';
              sctx.shadowBlur = 5;
              sctx.fillText(en ? 'COMET · PERIHELION' : '彗星 · 近日点', px, py - 14 * scale);
              sctx.shadowBlur = 0;
              sctx.globalAlpha = 1;
            }
          };

          // ---- 深度分层：远侧行星 → 太阳 → 近侧行星（行星从太阳背后绕过）----
          const far = positions.filter((it) => it.y < cy).sort((a, b) => a.y - b.y);
          const near = positions.filter((it) => it.y >= cy).sort((a, b) => a.y - b.y);
          const cometFar = cometPos.y < cy;
          for (const it of far) drawPlanet(it);
          if (cometFar) drawComet();
          // 太阳（白热核心 + 呼吸日冕）
          const sunR = Math.max(10, unit * .058);
          const pulse = 1 + .05 * Math.sin(t * .0011);
          const glow = sctx.createRadialGradient(cx, cy, 0, cx, cy, sunR * 3.4 * pulse);
          glow.addColorStop(0, 'rgba(255, 236, 190, .95)');
          glow.addColorStop(.3, 'rgba(255, 186, 100, .3)');
          glow.addColorStop(1, 'rgba(255, 170, 90, 0)');
          sctx.fillStyle = glow;
          sctx.beginPath();
          sctx.arc(cx, cy, sunR * 3.4 * pulse, 0, TAU);
          sctx.fill();
          const core = sctx.createRadialGradient(cx - sunR * .2, cy - sunR * .2, 0, cx, cy, sunR);
          core.addColorStop(0, '#fffdf4');
          core.addColorStop(.7, '#ffe3a6');
          core.addColorStop(1, '#ffb95e');
          sctx.fillStyle = core;
          sctx.beginPath();
          sctx.arc(cx, cy, sunR, 0, TAU);
          sctx.fill();
          for (const it of near) drawPlanet(it);
          if (!cometFar) drawComet();
          // 悬停行星：记录高亮（下一帧轨道加亮）+ 名称
          hoveredPlanet = null;
          if (mouseX >= 0) {
            for (const it of positions) {
              if (Math.hypot(mouseX - it.x, mouseY - it.y) < Math.max(15, it.r + 8)) {
                hoveredPlanet = it.p;
                sctx.fillStyle = 'rgba(255, 255, 255, .82)';
                sctx.font = `600 ${Math.max(9, 9.5 * scale)}px ui-monospace, Menlo, monospace`;
                sctx.textAlign = 'center';
                sctx.shadowColor = 'rgba(5, 7, 13, .9)';
                sctx.shadowBlur = 5;
                sctx.fillText(it.p.name, it.x, it.y - it.r - 10 * scale);
                sctx.shadowBlur = 0;
                break;
              }
            }
          }
          // 陨石雨（Konami 彩蛋触发，真实时钟驱动，暂停时间轴也在飞）
          if (showerUntil > realNow) {
            for (const m of meteors) {
              if (!m.born || realNow - m.born > m.ttl) {
                m.born = realNow;
                m.ttl = 800 + rand() * 900;
                m.x = rand() * panelW;
                m.y = rand() * panelH * .45;
                m.vx = (rand() < .5 ? -1 : 1) * (90 + rand() * 110);
                m.vy = 40 + rand() * 60;
              }
            }
          }
          for (const m of meteors) {
            if (!m.born) continue;
            const prog = (realNow - m.born) / m.ttl;
            if (prog >= 1) continue;
            const hx = m.x + m.vx * (realNow - m.born) / 1000;
            const hy = m.y + m.vy * (realNow - m.born) / 1000;
            const vlen = Math.hypot(m.vx, m.vy) || 1;
            const len = 70 + 40 * Math.sin(Math.PI * prog);
            const alpha = Math.sin(Math.PI * prog) * .85;
            const grad = sctx.createLinearGradient(hx, hy, hx - (m.vx / vlen) * len, hy - (m.vy / vlen) * len);
            grad.addColorStop(0, `rgba(255, 240, 214, ${alpha})`);
            grad.addColorStop(1, 'rgba(255, 240, 214, 0)');
            sctx.strokeStyle = grad;
            sctx.lineWidth = 1.4;
            sctx.beginPath();
            sctx.moveTo(hx, hy);
            sctx.lineTo(hx - (m.vx / vlen) * len, hy - (m.vy / vlen) * len);
            sctx.stroke();
          }
        };
        const handleSpaceResize = () => {
          resizeSpace();
          if (reducedMotion) drawSpace(performance.now());
        };
        if ('ResizeObserver' in window) {
          new ResizeObserver(handleSpaceResize).observe(spaceCanvas);
        } else {
          window.addEventListener('resize', handleSpaceResize, { passive: true });
        }

        // ===== 行星资料卡（点击行星弹出）=====
        const planetCard = document.querySelector('#planet-card');
        const PLANET_INFO = {
          MERCURY: { zh: '水星', en: 'Mercury', diameter: '4,879 km', year: '88 天', moons: '0', line: { zh: '离太阳最近的跑者——学习也是贴着核心一圈圈转。', en: 'Closest to the sun — learning loops close to the core.' } },
          VENUS: { zh: '金星', en: 'Venus', diameter: '12,104 km', year: '225 天', moons: '0', line: { zh: '反着自转的特立独行者——偶尔反套路反而有效。', en: 'It spins backwards — the reverse trick works sometimes.' } },
          EARTH: { zh: '地球', en: 'Earth', diameter: '12,756 km', year: '365 天', moons: '1', line: { zh: '我的网络据点就在这颗蓝色星球上。', en: 'My corner of the internet lives on this blue planet.' } },
          MARS: { zh: '火星', en: 'Mars', diameter: '6,792 km', year: '687 天', moons: '2', line: { zh: '移民候选第一站——新方向也先在这里选址。', en: 'The first colony candidate — new directions scout here.' } },
          JUPITER: { zh: '木星', en: 'Jupiter', diameter: '142,984 km', year: '11.9 年', moons: '95', line: { zh: '大块头引力场——像 ave-mygo，什么都装得下。', en: 'The big hauler — like ave-mygo, it fits everything.' } },
          SATURN: { zh: '土星', en: 'Saturn', diameter: '120,536 km', year: '29.5 年', moons: '274', line: { zh: '光环最好看的行星——好看的细节值得慢慢打磨。', en: 'Best rings in town — polish the details people see.' } },
          URANUS: { zh: '天王星', en: 'Uranus', diameter: '51,118 km', year: '84 年', moons: '28', line: { zh: '躺着自转的懒骨头——休息也是开发的一部分。', en: 'It rolls on its side — rest is part of the process.' } },
          NEPTUNE: { zh: '海王星', en: 'Neptune', diameter: '49,528 km', year: '165 年', moons: '16', line: { zh: '先用数学算出来再找到的行星——先推演，再动手验证。', en: 'Found by math before telescopes — derive first, verify by doing.' } },
        };
        const closePlanetCard = () => {
          selectedPlanet = null;
          if (planetCard) planetCard.hidden = true;
        };
        const openPlanetCard = (item) => {
          if (!planetCard) return;
          const info = PLANET_INFO[item.p.name];
          if (!info) return;
          selectedPlanet = item.p;
          planetCard.innerHTML = `
            <button class="planet-card-close" type="button" aria-label="关闭资料卡">×</button>
            <h4><span class="i18n-zh">${info.zh}</span><span class="i18n-en">${info.en}</span></h4>
            <dl>
              <div><dt><span class="i18n-zh">直径</span><span class="i18n-en">DIAMETER</span></dt><dd>${info.diameter}</dd></div>
              <div><dt><span class="i18n-zh">公转周期</span><span class="i18n-en">ORBIT</span></dt><dd>${info.year}</dd></div>
              <div><dt><span class="i18n-zh">卫星</span><span class="i18n-en">MOONS</span></dt><dd>${info.moons}</dd></div>
            </dl>
            <p class="planet-card-line"><span class="i18n-zh">${info.line.zh}</span><span class="i18n-en">${info.line.en}</span></p>`;
          planetCard.hidden = false;
          const cw = planetCard.offsetWidth, ch = planetCard.offsetHeight;
          let left = item.x + 22;
          if (left + cw > panelW - 12) left = item.x - cw - 22;
          left = Math.max(12, Math.min(left, Math.max(12, panelW - cw - 12)));
          const top = Math.max(12, Math.min(item.y - ch / 2, Math.max(12, panelH - ch - 12)));
          planetCard.style.left = `${left}px`;
          planetCard.style.top = `${top}px`;
          planetCard.querySelector('.planet-card-close')?.addEventListener('click', closePlanetCard);
        };
        spaceCanvas.addEventListener('click', (e) => {
          const rect = spaceCanvas.getBoundingClientRect();
          const mx = e.clientX - rect.left, my = e.clientY - rect.top;
          let hit = null;
          for (const it of lastPositions) {
            if (Math.hypot(mx - it.x, my - it.y) < Math.max(16, it.r + 9)) { hit = it; break; }
          }
          if (hit) openPlanetCard(hit);
          else closePlanetCard();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && planetCard && !planetCard.hidden) closePlanetCard();
        });

        // ===== 时间控制（⏸/▶ + 0.5×/1×/4×，驱动模拟时钟 simT）=====
        const hqControls = document.querySelector('#hq-controls');
        const playBtn = document.querySelector('#hq-play');
        let speed = 1, paused = false;
        if (hqControls && playBtn && !reducedMotion) {
          hqControls.hidden = false;
          playBtn.addEventListener('click', () => {
            paused = !paused;
            playBtn.textContent = paused ? '▶' : '⏸';
            playBtn.setAttribute('aria-pressed', String(!paused));
            playBtn.setAttribute('aria-label', paused ? '继续动画' : '暂停动画');
          });
          hqControls.addEventListener('click', (event) => {
            const btn = event.target.closest('button[data-speed]');
            if (!btn) return;
            speed = Number(btn.dataset.speed);
            hqControls.querySelectorAll('button[data-speed]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          });
        }

        // Konami 彩蛋入口：命令面板触发陨石雨（非首页没有 canvas，走 CSS 流星雨）
        window.__solarShower = () => {
          if (reducedMotion) return;
          showerUntil = performance.now() + 8000;
          meteors.forEach((m) => { m.born = 0; });
        };

        let spaceRunning = false, spaceVisible = false, spaceRafId = 0, lastFrameTime = 0, lastRafTime = 0, simT = 0;
        const spaceLoop = (now) => {
          const dt = lastRafTime ? Math.min(now - lastRafTime, 100) : 16.7;
          lastRafTime = now;
          if (!paused) simT += dt * speed;
          if (now - lastFrameTime >= 1000 / 30) {
            drawSpace(simT);
            lastFrameTime = now;
          }
          if (spaceRunning) spaceRafId = requestAnimationFrame(spaceLoop);
        };
        const setSpaceRunning = (run) => {
          if (run && !spaceRunning) {
            spaceRunning = true;
            lastFrameTime = 0;
            lastRafTime = 0;
            spaceRafId = requestAnimationFrame(spaceLoop);
          } else if (!run && spaceRunning) {
            spaceRunning = false;
            cancelAnimationFrame(spaceRafId);
          }
        };
        const syncSpaceVisibility = () => setSpaceRunning(spaceVisible && !document.hidden);
        document.addEventListener('visibilitychange', syncSpaceVisibility);
        if (reducedMotion) {
          drawSpace(0); // 静态帧
        } else {
          // 面板滚出视口时暂停动画，省电
          if ('IntersectionObserver' in window) {
            new IntersectionObserver((entries) => {
              spaceVisible = entries[0].isIntersecting;
              syncSpaceVisibility();
            }, { threshold: .05 })
              .observe(spaceCanvas);
          } else {
            spaceVisible = true;
            syncSpaceVisibility();
          }
        }
      }

      // ===== 背景音效（默认关闭）=====
      const sound = document.querySelector('#sound');
      let audioContext;
      let voices = [];
      sound?.addEventListener('click', async () => {
        const enabled = sound.getAttribute('aria-pressed') !== 'true';
        if (enabled) {
          audioContext ??= new AudioContext();
          if (audioContext.state === 'suspended') await audioContext.resume();
          voices = [110, 164.81, 220].map((frequency, index) => {
            const oscillator = audioContext.createOscillator();
            const volume = audioContext.createGain();
            oscillator.type = index === 1 ? 'triangle' : 'sine';
            oscillator.frequency.value = frequency;
            volume.gain.value = 0.004;
            oscillator.connect(volume).connect(audioContext.destination);
            oscillator.start();
            return { oscillator, volume };
          });
        } else {
          voices.forEach(({ oscillator, volume }) => {
            volume.gain.setTargetAtTime(0, audioContext.currentTime, .08);
            oscillator.stop(audioContext.currentTime + .35);
          });
          voices = [];
        }
        sound.setAttribute('aria-pressed', String(enabled));
        sound.setAttribute('aria-label', enabled ? '关闭背景音效' : '开启背景音效');
      });

      // ===== 首屏 motto 打字机（借鉴 phlin 博客的 Typed 效果，零依赖手写）=====
      const typedEl = document.querySelector('#hero-typed');
      if (typedEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const phrases = ['KEEP CODING', 'KEEP BUILDING', 'KEEP LEARNING', 'STAY CURIOUS'];
        let phraseIndex = 0;
        let charIndex = phrases[0].length;
        let deleting = true;
        const typeTick = () => {
          const word = phrases[phraseIndex];
          if (deleting) {
            charIndex -= 1;
            typedEl.textContent = word.slice(0, Math.max(0, charIndex));
            if (charIndex <= 0) {
              deleting = false;
              phraseIndex = (phraseIndex + 1) % phrases.length;
              charIndex = 0;
              setTimeout(typeTick, 420);
              return;
            }
            setTimeout(typeTick, 48);
          } else {
            charIndex += 1;
            typedEl.textContent = word.slice(0, charIndex);
            if (charIndex >= word.length) {
              deleting = true;
              setTimeout(typeTick, 1900);
              return;
            }
            setTimeout(typeTick, 88);
          }
        };
        setTimeout(typeTick, 3000); // 等开场白幕动画结束
      }

      // ===== 页脚：据点已运行天数 =====
      document.querySelectorAll('[data-site-days]').forEach((el) => {
        const birth = new Date(el.dataset.birth).getTime();
        if (Number.isNaN(birth)) return;
        el.textContent = Math.max(1, Math.floor((Date.now() - birth) / 86400000));
      });
    </script>
  </body>
</html>
