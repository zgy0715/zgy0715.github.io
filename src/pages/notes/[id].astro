---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const dateStr = note.data.date.toISOString().slice(0, 10);
const updatedStr = note.data.updated ? note.data.updated.toISOString().slice(0, 10) : null;
// 阅读时长：按正文字符数估算（中文约 400 字/分钟）
const minutes = Math.max(1, Math.ceil((note.body ?? '').replace(/\s/g, '').length / 400));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#3388bb" />
    <meta name="description" content={note.data.summary ?? note.data.title} />
    <title>{note.data.title} · YZBZGY</title>
    <script is:inline>
      (function () {
        try {
          var lang = localStorage.getItem('site-lang') || 'zh';
          if (lang === 'en') {
            document.documentElement.classList.add('lang-en');
            document.documentElement.lang = 'en';
          }
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        color-scheme: light;
        --black: #0a0a0a;
        --white: #fff;
        --blue: #3388bb;
        --blue-dark: #287aac;
        --blue-light: #77bbdd;
        --pink: #ff8899;
        --sans: 'IBM Plex Sans SC', sans-serif;
        --display: 'Bebas Neue', sans-serif;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        --pad: clamp(20px, 6vw, 72px);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--white); color: var(--black); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      ::selection { color: #fff; background: var(--blue); }
      :focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
      .i18n-en { display: none; }
      html.lang-en .i18n-zh { display: none; }
      html.lang-en .i18n-en { display: inline; }

      .note-page { max-width: 780px; margin: 0 auto; padding: 96px var(--pad) 60px; min-height: 100svh; display: flex; flex-direction: column; }
      .note-top { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 44px; }
      .note-top .brand { font: 400 1.5rem var(--display); letter-spacing: .06em; text-decoration: none; }
      .note-top .back { font: 10px var(--mono); letter-spacing: .2em; text-decoration: none; transition: color .2s; }
      .note-top .back:hover { color: var(--blue); }
      .article-meta { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin: 0 0 14px; font: 9px var(--mono); letter-spacing: .18em; color: #666; }
      .article-meta span { padding: 5px 9px; border: 1px solid rgba(0, 0, 0, .35); border-radius: 999px; }
      h1.article-title { margin: 0 0 34px; font: 700 clamp(1.9rem, 5.5vw, 3.2rem)/1.2 var(--sans); letter-spacing: .01em; }

      .prose { font-size: 15px; line-height: 2.1; }
      .prose h2 { margin: 2.4em 0 .6em; font: 700 1.3rem var(--sans); letter-spacing: .02em; }
      .prose h2::before { content: '// '; color: var(--blue); font: 400 1em var(--mono); }
      .prose h3 { margin: 2em 0 .5em; font: 700 1.1rem var(--sans); }
      .prose p { margin: 1.2em 0; color: #222; }
      .prose a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
      .prose a:hover { color: var(--blue-dark); }
      .prose ul, .prose ol { padding-left: 1.4em; margin: 1.2em 0; }
      .prose li { margin: .4em 0; }
      .prose li::marker { color: var(--blue); }
      .prose blockquote { margin: 1.6em 0; padding: .2em 0 .2em 1.2em; border-left: 3px solid var(--pink); color: #555; }
      .prose code { padding: 2px 6px; background: rgba(51, 136, 187, .1); border-radius: 3px; font: .88em var(--mono); color: var(--blue-dark); }
      .prose pre { margin: 1.6em 0; padding: 18px; overflow-x: auto; background: var(--black); color: #e6e6e6; border-radius: 0; font: 13px/1.75 var(--mono); }
      .prose pre code { padding: 0; background: none; color: inherit; font-size: inherit; }
      .prose hr { margin: 2.4em 0; border: 0; border-top: 1px solid rgba(0, 0, 0, .2); }
      .prose img { max-width: 100%; }

      .note-footer { margin-top: auto; padding-top: 60px; display: flex; justify-content: space-between; align-items: center; gap: 16px; border-top: 1px solid rgba(0, 0, 0, .2); }
      .note-footer a { font: 10px var(--mono); letter-spacing: .2em; text-decoration: none; transition: color .2s; }
      .note-footer a:hover { color: var(--blue); }
      .note-footer .copyright { font: 9px var(--mono); letter-spacing: .2em; color: #999; }

      @media (max-width: 760px) {
        .note-page { padding-top: 72px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
    </style>
  </head>
  <body>
    <div class="note-page">
      <header class="note-top">
        <a class="brand" href="/">YZBZGY</a>
        <a class="back" href="/notes/"><span aria-hidden="true">←</span> <span class="i18n-zh">全部笔记</span><span class="i18n-en">ALL NOTES</span></a>
      </header>
      <main>
        <p class="article-meta">
          <time datetime={dateStr}>{dateStr}</time>
          {updatedStr && updatedStr !== dateStr && <span><span class="i18n-zh">更新</span><span class="i18n-en">EDITED</span> {updatedStr}</span>}
          <span>≈ {minutes} <span class="i18n-zh">分钟</span><span class="i18n-en">MIN</span></span>
          {note.data.tags.map((tag) => <span>{tag}</span>)}
        </p>
        <h1 class="article-title">{note.data.title}</h1>
        <div class="prose">
          <Content />
        </div>
      </main>
      <footer class="note-footer">
        <a href="/notes/"><span aria-hidden="true">←</span> <span class="i18n-zh">返回列表</span><span class="i18n-en">BACK TO LIST</span></a>
        <span class="copyright">© 2026 YZBZGY</span>
      </footer>
    </div>
  </body>
</html>
