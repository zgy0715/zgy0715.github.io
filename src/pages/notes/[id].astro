---
import { getCollection, render } from 'astro:content';
import '@fontsource/bebas-neue';
import '@ibm/plex-sans-sc/css/yzb-subset.css';

// 站点色板：与笔记列表页一致的标签哈希映射
const PALETTE = ['#3388bb', '#ff8899', '#287aac', '#77bbdd'];
const tagColor = (tag) => PALETTE[[...tag].reduce((h, c) => h + c.charCodeAt(0), 0) % PALETTE.length];

export async function getStaticPaths() {
  const notes = (await getCollection('notes'))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return notes.map((note, i) => ({
    params: { id: note.id },
    props: { note, newer: notes[i - 1] ?? null, older: notes[i + 1] ?? null },
  }));
}

const { note, newer, older } = Astro.props;
// 相关笔记：共享标签数降序取前 3（渲染期计算）
const allNotes = await getCollection('notes');
const related = allNotes
  .filter((n) => n.id !== note.id)
  .map((n) => ({ n, shared: n.data.tags.filter((t) => note.data.tags.includes(t)).length }))
  .filter((x) => x.shared > 0)
  .sort((a, b) => b.shared - a.shared)
  .slice(0, 3)
  .map((x) => ({ note: x.n, color: tagColor(x.n.data.tags[0] ?? 'META') }));
const { Content, headings } = await render(note);
// 目录：只取 h2/h3（Astro 渲染时自动带 slug id）
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const dateStr = note.data.date.toISOString().slice(0, 10);
const updatedStr = note.data.updated ? note.data.updated.toISOString().slice(0, 10) : null;// 阅读时长：按正文字符数估算（中文约 400 字/分钟）
const minutes = Math.max(1, Math.ceil((note.body ?? '').replace(/\s/g, '').length / 400));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#3388bb" />
    <meta name="description" content={note.data.summary ?? note.data.title} />
    <title>{note.data.title} · YZBZGY</title>
    <meta property="og:image" content="https://zgy0715.github.io/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%233388bb'/%3E%3Ctext x='32' y='45' font-family='sans-serif' font-size='38' font-weight='bold' fill='white' text-anchor='middle'%3EY%3C/text%3E%3C/svg%3E" />
    <link rel="canonical" href={`https://zgy0715.github.io/notes/${note.id}/`} />
    <meta property="og:title" content={note.data.title} />
    {note.data.summary && <meta property="og:description" content={note.data.summary} />}
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`https://zgy0715.github.io/notes/${note.id}/`} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: note.data.title,
      ...(note.data.summary ? { description: note.data.summary } : {}),
      datePublished: dateStr,
      dateModified: updatedStr ?? dateStr,
      keywords: note.data.tags.join(', '),
      author: { '@type': 'Person', name: 'YZBZGY' },
      image: 'https://zgy0715.github.io/og-image.png',
      mainEntityOfPage: `https://zgy0715.github.io/notes/${note.id}/`,
    })} />
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('site-theme');
          var lang = localStorage.getItem('site-lang') || 'zh';
          if (lang === 'en') {
            document.documentElement.classList.add('lang-en');
            document.documentElement.lang = 'en';
          }
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.content = theme === 'dark' ? '#0f1115' : '#3388bb';
      })();
    </script>
    <style is:global>
      :root {
        color-scheme: light;
        --black: #0a0a0a;
        --white: #fff;
        --blue: #3388bb;
        --blue-dark: #287aac;
        --blue-light: #77bbdd;
        --pink: #ff8899;
        --gold: #bb9955;
        --sans: 'IBM Plex Sans SC', sans-serif;
        --display: 'Bebas Neue', sans-serif;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        --pad: clamp(20px, 6vw, 72px);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--white); color: var(--black); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      ::selection { color: #fff; background: var(--blue); }
      :focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
      .i18n-en { display: none; }
      html.lang-en .i18n-zh { display: none; }
      html.lang-en .i18n-en { display: inline; }

      .note-page { max-width: 1240px; margin: 0 auto; padding: 96px var(--pad) 60px; min-height: 100svh; display: flex; flex-direction: column; }
      /* ===== 阅读进度条 ===== */
      .read-progress { position: fixed; top: 0; left: 0; z-index: 100; height: 3px; width: 0; background: var(--gold); }
      /* ===== 双栏（正文 + 目录）===== */
      .note-columns { display: grid; grid-template-columns: minmax(0, 1fr); }
      .article-col { max-width: 780px; width: 100%; margin: 0 auto; }
      .note-below { max-width: 780px; width: 100%; margin: 0 auto; }
      .toc { display: none; }
      @media (min-width: 1240px) {
        .note-columns { grid-template-columns: minmax(0, 780px) 250px; justify-content: space-between; }
        .note-below { margin: 0; }
        .toc { display: block; position: sticky; top: 90px; align-self: start; max-height: calc(100vh - 130px); overflow: auto; }
      }
      .toc-title { margin: 0 0 12px; font: 9px var(--mono); letter-spacing: .2em; color: #888; }
      .toc ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid rgba(0, 0, 0, .18); }
      .toc a { display: block; padding: 5px 0 5px 14px; margin-left: -1px; border-left: 2px solid transparent; font-size: 12.5px; line-height: 1.6; color: #666; text-decoration: none; transition: color .2s, border-color .2s; }
      .toc a:hover { color: var(--blue); }
      .toc a.active { color: var(--blue); border-color: var(--gold); }
      .toc .toc-d3 a { padding-left: 26px; font-size: 12px; }
      .prose h2, .prose h3 { scroll-margin-top: 90px; }
      /* ===== 评论区（giscus，点击加载）===== */
      .comments { margin-top: 60px; }
      .related { margin-top: 50px; }
      .related-list { list-style: none; margin: 0; padding: 0; }
      .related-list li { border-bottom: 1px solid rgba(0, 0, 0, .15); }
      .related-list li:first-child { border-top: 1px solid rgba(0, 0, 0, .15); }
      .related-list a { display: flex; align-items: baseline; gap: 12px; padding: 13px 2px; text-decoration: none; transition: padding-left .2s; }
      .related-list a:hover { padding-left: 10px; }
      .related-list a:hover b { color: var(--blue); }
      .related-list .rel-dot { flex: none; width: 8px; height: 8px; border-radius: 50%; align-self: center; }
      .related-list b { flex: 1; font-weight: 500; font-size: 14px; transition: color .2s; }
      .related-list time { font: 9px var(--mono); letter-spacing: .14em; color: #888; }
      .comments-title { margin: 0 0 20px; font: 9px var(--mono); letter-spacing: .2em; color: #888; }
      .giscus-load { display: inline-block; padding: 12px 20px; border: 1px solid rgba(0, 0, 0, .35); background: none; cursor: pointer; font: 12px var(--sans); color: #444; transition: border-color .2s, color .2s; }
      .giscus-load:hover { border-color: var(--blue); color: var(--blue); }
      .note-top { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 44px; }
      .top-actions { display: flex; align-items: center; gap: 16px; }
      .lang-toggle { display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border: 1px solid rgba(0, 0, 0, .4); border-radius: 999px; background: none; cursor: pointer; font: 10px var(--mono); letter-spacing: .1em; }
      .lang-toggle span { opacity: .4; transition: opacity .2s; }
      html.lang-zh .lang-toggle .lang-zh-mark, html.lang-en .lang-toggle .lang-en-mark { opacity: 1; font-weight: 700; }
      .lang-toggle i { font-style: normal; opacity: .35; }
      .theme-toggle { width: 33px; height: 33px; display: inline-flex; align-items: center; justify-content: center; padding: 0; border: 1px solid rgba(0, 0, 0, .4); border-radius: 50%; background: none; cursor: pointer; font-size: 14px; line-height: 1; transition: transform .3s ease, border-color .2s; }
      .theme-toggle:hover { border-color: #000; transform: rotate(24deg); }
      .skip-link { position: fixed; z-index: 90; top: 12px; left: 12px; padding: 12px 16px; background: var(--black); color: #fff; font: 12px var(--mono); text-decoration: none; transform: translateY(-180%); }
      .skip-link:focus { transform: none; }
      .note-top .brand { font: 400 1.5rem var(--display); letter-spacing: .06em; text-decoration: none; }
      .note-top .back { font: 10px var(--mono); letter-spacing: .2em; text-decoration: none; transition: color .2s; }
      .note-top .back:hover { color: var(--blue); }
      .article-meta { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin: 0 0 14px; font: 9px var(--mono); letter-spacing: .18em; color: #666; }
      .meta-icon { width: 11px; height: 11px; display: inline-block; vertical-align: -1.5px; margin-right: 5px; opacity: .6; }
      .article-meta span { padding: 5px 9px; border: 1px solid rgba(0, 0, 0, .35); border-radius: 999px; }
      h1.article-title { margin: 0 0 34px; font: 700 clamp(1.9rem, 5.5vw, 3.2rem)/1.2 var(--sans); letter-spacing: .01em; }

      .prose { font-size: 15px; line-height: 2.1; opacity: 0; filter: blur(8px); animation: blur-in .8s cubic-bezier(.2, .7, .2, 1) .15s forwards; }
      @keyframes blur-in { to { opacity: 1; filter: blur(0); } }
      .prose h2 { margin: 2.4em 0 .6em; font: 700 1.3rem var(--sans); letter-spacing: .02em; }
      .prose h2::before { content: '// '; color: var(--blue); font: 400 1em var(--mono); }
      .prose h3 { margin: 2em 0 .5em; font: 700 1.1rem var(--sans); }
      .prose p { margin: 1.2em 0; color: #222; }
      .prose a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
      .prose a:hover { color: var(--blue-dark); }
      .prose ul, .prose ol { padding-left: 1.4em; margin: 1.2em 0; }
      .prose li { margin: .4em 0; }
      .prose li::marker { color: var(--blue); }
      .prose blockquote { margin: 1.6em 0; padding: .2em 0 .2em 1.2em; border-left: 3px solid var(--pink); color: #555; }
      .prose code { padding: 2px 6px; background: rgba(51, 136, 187, .1); border-radius: 3px; font: .88em var(--mono); color: var(--blue-dark); }
      .prose pre { margin: 1.6em 0; padding: 18px; overflow-x: auto; background: var(--black); color: #e6e6e6; border-radius: 0; font: 13px/1.75 var(--mono); }
      .prose pre code { padding: 0; background: none; color: inherit; font-size: inherit; }
      .prose hr { margin: 2.4em 0; border: 0; border-top: 1px solid rgba(0, 0, 0, .2); }
      .prose img { max-width: 100%; }

      .note-footer { margin-top: auto; padding-top: 60px; display: flex; justify-content: space-between; align-items: center; gap: 16px; border-top: 1px solid rgba(0, 0, 0, .2); }
      .note-prevnext { display: flex; justify-content: space-between; gap: 16px; margin-top: 50px; }
      .note-prevnext a { display: grid; gap: 6px; max-width: 46%; padding: 14px 16px; border: 1px solid rgba(0, 0, 0, .25); text-decoration: none; transition: border-color .2s, color .2s; }
      .note-prevnext a small { font: 9px var(--mono); letter-spacing: .16em; color: #888; }
      .note-prevnext a b { font: 700 13.5px/1.5 var(--sans); }
      .note-prevnext a:hover { border-color: var(--blue); color: var(--blue); }
      .note-prevnext a.next { text-align: right; margin-left: auto; }
      .note-footer a { font: 10px var(--mono); letter-spacing: .2em; text-decoration: none; transition: color .2s; }
      .note-footer a:hover { color: var(--blue); }
      .note-footer .copyright { font: 9px var(--mono); letter-spacing: .2em; color: #999; }

      @media (max-width: 760px) {
        .note-page { padding-top: 72px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .prose { animation: none; opacity: 1; filter: blur(0); }
      }

      /* ===== 暗色模式（跟随系统）===== */
      /* ===== 暗色主题（手动切换，首次跟随系统）===== */
      [data-theme="dark"] body { background: #0f1115; color: #e8e8e8; }
      [data-theme="dark"] .article-meta { color: #999; }
      [data-theme="dark"] .article-meta span { border-color: rgba(255, 255, 255, .4); }
      [data-theme="dark"] .prose p { color: #c9c9c9; }
      [data-theme="dark"] .prose a { color: var(--blue-light); }
      [data-theme="dark"] .prose a:hover { color: #a5d3ea; }
      [data-theme="dark"] .prose code { background: rgba(119, 187, 221, .12); color: var(--blue-light); }
      [data-theme="dark"] .prose blockquote { color: #999; border-color: var(--pink); }
      [data-theme="dark"] .prose pre { border: 1px solid rgba(255, 255, 255, .2); }
      [data-theme="dark"] .note-top .back:hover { color: var(--blue-light); }
      [data-theme="dark"] .note-footer, [data-theme="dark"] .note-prevnext a { border-color: rgba(255, 255, 255, .22); }
      [data-theme="dark"] .note-prevnext a:hover { border-color: var(--blue-light); color: var(--blue-light); }
      [data-theme="dark"] .note-footer a:hover { color: var(--blue-light); }
      [data-theme="dark"] .note-footer .copyright { color: #666; }
      [data-theme="dark"] .lang-toggle, [data-theme="dark"] .theme-toggle { border-color: rgba(255, 255, 255, .4); }
      [data-theme="dark"] .theme-toggle:hover { border-color: #fff; }
      [data-theme="dark"] .skip-link { background: #fff; color: #000; }
      [data-theme="dark"] .toc-title, [data-theme="dark"] .comments-title { color: #777; }
      [data-theme="dark"] .toc ul { border-color: rgba(255, 255, 255, .22); }
      [data-theme="dark"] .toc a { color: #999; }
      [data-theme="dark"] .toc a.active { color: var(--blue-light); }
      [data-theme="dark"] .giscus-load { border-color: rgba(255, 255, 255, .35); color: #bbb; }
      [data-theme="dark"] .giscus-load:hover { border-color: var(--blue-light); color: var(--blue-light); }
      [data-theme="dark"] .related-list li { border-color: rgba(255, 255, 255, .22); }
      [data-theme="dark"] .related-list a:hover b { color: var(--blue-light); }
      [data-theme="dark"] .related-list time { color: #777; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#note-main">跳到主要内容</a>
    <div class="note-page">
      <header class="note-top">
        <a class="brand" href="/">YZBZGY</a>
        <div class="top-actions">
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换明暗主题">☾</button>
          <button class="lang-toggle" id="lang-toggle" type="button" aria-label="切换语言 / Switch language"><span class="lang-zh-mark">中</span><i>/</i><span class="lang-en-mark">EN</span></button>
          <a class="back" href="/notes/"><span aria-hidden="true">←</span> <span class="i18n-zh">全部笔记</span><span class="i18n-en">ALL NOTES</span></a>
        </div>
      </header>
      <div class="read-progress" id="read-progress" aria-hidden="true"></div>
      <div class="note-columns">
      <main id="note-main" class="article-col">
        <p class="article-meta">
          <time datetime={dateStr}><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/><line x1="3.5" y1="10.5" x2="20.5" y2="10.5"/></svg>{dateStr.replace(/-/g, '.')}</time>
          {updatedStr && updatedStr !== dateStr && <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l4-1 10-10-3-3L5 16z"/><path d="M14 6l3 3"/></svg><span class="i18n-zh">更新</span><span class="i18n-en">EDITED</span> {updatedStr.replace(/-/g, '.')}</span>}
          <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>≈ {minutes} <span class="i18n-zh">分钟</span><span class="i18n-en">MIN</span></span>
          {note.data.tags.map((tag) => <span>{tag}</span>)}
        </p>
        <h1 class="article-title">{note.data.title}</h1>
        <div class="prose">
          <Content />
        </div>
      </main>
      {toc.length > 0 && (
        <aside class="toc" aria-label="目录">
          <p class="toc-title"><span class="i18n-zh">目录</span><span class="i18n-en">CONTENTS</span></p>
          <ul>
            {toc.map((h) => <li class={h.depth === 3 ? 'toc-d3' : ''}><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ul>
        </aside>
      )}
      </div>
      <div class="note-below">
      <nav class="note-prevnext" aria-label="相邻笔记">
        {newer ? <a href={`/notes/${newer.id}/`} class="pn"><small>← <span class="i18n-zh">更新一篇</span><span class="i18n-en">NEWER</span></small><b>{newer.data.title}</b></a> : <span />}
        {older ? <a href={`/notes/${older.id}/`} class="pn next"><small><span class="i18n-zh">更早一篇</span><span class="i18n-en">OLDER</span> →</small><b>{older.data.title}</b></a> : <span />}
      </nav>
      {related.length > 0 && (
        <section class="related" aria-label="同主题笔记">
          <h2 class="comments-title"><span class="i18n-zh">同主题笔记</span><span class="i18n-en">RELATED NOTES</span></h2>
          <ul class="related-list">
            {related.map((r) => (
              <li>
                <a href={`/notes/${r.note.id}/`}>
                  <i class="rel-dot" style={`background:${r.color}`} aria-hidden="true"></i>
                  <b>{r.note.data.title}</b>
                  <time>{r.note.data.date.toISOString().slice(0, 10).replace(/-/g, '.')}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <section class="comments">
        <h2 class="comments-title"><span class="i18n-zh">评论 · GitHub账号登录后可留言</span><span class="i18n-en">COMMENTS · SIGN IN WITH GITHUB</span></h2>
        <button id="giscus-load" class="giscus-load" type="button"><span class="i18n-zh">展开评论区</span><span class="i18n-en">LOAD COMMENTS</span></button>
        <div id="giscus-container"></div>
      </section>
      <footer class="note-footer">
        <a href="/notes/"><span aria-hidden="true">←</span> <span class="i18n-zh">返回列表</span><span class="i18n-en">BACK TO LIST</span></a>
        <span class="copyright">© 2026 YZBZGY</span>
      </footer>
      </div>
    </div>
    <script>
      // ===== 中 / EN 语言切换（与全站共享 localStorage）=====
      const rootHtml = document.documentElement;
      const langToggle = document.querySelector('#lang-toggle');
      const applyLang = (lang) => {
        rootHtml.classList.toggle('lang-en', lang === 'en');
        rootHtml.classList.toggle('lang-zh', lang !== 'en');
        rootHtml.lang = lang === 'en' ? 'en' : 'zh-CN';
        try { localStorage.setItem('site-lang', lang); } catch (e) {}
      };
      applyLang(rootHtml.classList.contains('lang-en') ? 'en' : 'zh');
      langToggle?.addEventListener('click', () => {
        applyLang(rootHtml.classList.contains('lang-en') ? 'zh' : 'en');
      });

      // ===== 明暗主题切换（与全站共享 localStorage）=====
      const themeToggle = document.querySelector('#theme-toggle');
      let applyTheme = (theme) => {
        rootHtml.dataset.theme = theme;
        if (themeToggle) {
          themeToggle.textContent = theme === 'dark' ? '☀' : '☾';
          themeToggle.setAttribute('aria-label', theme === 'dark' ? '切换到浅色模式' : '切换到深色模式');
        }
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.content = theme === 'dark' ? '#0f1115' : '#3388bb';
        try { localStorage.setItem('site-theme', theme); } catch (e) {}
      };
      applyTheme(rootHtml.dataset.theme === 'dark' ? 'dark' : 'light');
      themeToggle?.addEventListener('click', () => {
        applyTheme(rootHtml.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      // ===== 阅读进度条 =====
      const readBar = document.querySelector('#read-progress');
      const updateProgress = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        readBar.style.width = (total > 0 ? Math.min(1, window.scrollY / total) * 100 : 0) + '%';
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();

      // ===== 目录高亮当前小节 =====
      const tocLinks = [...document.querySelectorAll('.toc a')];
      if (tocLinks.length) {
        const tocMap = new Map(tocLinks.map((a) => [a.getAttribute('href').slice(1), a]));
        const tocHeads = [...document.querySelectorAll('.prose h2[id], .prose h3[id]')];
        const highlightToc = () => {
          let current = tocHeads[0]?.id;
          for (const h of tocHeads) {
            if (h.getBoundingClientRect().top <= 120) current = h.id;
          }
          tocLinks.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === '#' + current));
        };
        window.addEventListener('scroll', highlightToc, { passive: true });
        highlightToc();
      }

      // ===== giscus 评论区（点击加载，主题联动）=====
      const giscusBtn = document.querySelector('#giscus-load');
      const notifyGiscus = (theme) => {
        const frame = document.querySelector('iframe.giscus-frame');
        frame?.contentWindow.postMessage({ giscus: { setConfig: { theme: theme === 'dark' ? 'dark' : 'light' } } }, 'https://giscus.app');
      };
      giscusBtn?.addEventListener('click', () => {
        giscusBtn.remove();
        const s = document.createElement('script');
        s.src = 'https://giscus.app/client.js';
        s.crossOrigin = 'anonymous';
        s.async = true;
        const cfg = {
          'data-repo': 'zgy0715/zgy0715.github.io',
          'data-repo-id': 'R_kgDOVJDMVQ',
          'data-category': 'Announcements',
          'data-category-id': 'DIC_kwDOVJDMVc4DI31M',
          'data-mapping': 'pathname',
          'data-strict': '0',
          'data-reactions-enabled': '1',
          'data-emit-metadata': '0',
          'data-input-position': 'top',
          'data-theme': rootHtml.dataset.theme === 'dark' ? 'dark' : 'light',
          'data-lang': 'zh-CN',
        };
        for (const [k, v] of Object.entries(cfg)) s.setAttribute(k, v);
        document.querySelector('#giscus-container').appendChild(s);
      });
      // 主题切换时同步 giscus 主题
      const _applyTheme = applyTheme;
      applyTheme = (theme) => { _applyTheme(theme); notifyGiscus(theme); };
    </script>
  </body>
</html>
