---
import { getCollection } from 'astro:content';
import '@fontsource/bebas-neue';
import '@ibm/plex-sans-sc/css/yzb-subset.css';
import CommandPalette from '../../components/CommandPalette.astro';

const raw = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 站点色板：标签颜色按标签名哈希稳定映射，重要笔记固定用粉色
const PALETTE = ['#3388bb', '#ff8899', '#287aac', '#77bbdd'];
const tagColor = (tag) => PALETTE[[...tag].reduce((h, c) => h + c.charCodeAt(0), 0) % PALETTE.length];

// 阅读时长：按正文字符数估算（中文约 400 字/分钟），构建期计算的真实数据
const notes = raw.map((note) => {
  const chars = (note.body ?? '').replace(/\s/g, '').length;
  return {
    ...note,
    minutes: Math.max(1, Math.ceil(chars / 400)),
    color: note.data.star ? '#ff8899' : tagColor(note.data.title),
  };
});

const tagCounts = {};
notes.forEach((n) => n.data.tags.forEach((t) => { tagCounts[t] = (tagCounts[t] ?? 0) + 1; }));
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
// 筛选栏只放热门标签（出现 ≥2 次）：一次性标签进栏只会筛出一条，纯噪音
const hotTags = tags.filter(([, c]) => c >= 2).slice(0, 10);
const starredCount = notes.filter((n) => n.data.star).length;
const lastUpdated = notes.reduce((m, n) => {
  const d = (n.data.updated ?? n.data.date);
  return d.valueOf() > m.valueOf() ? d : m;
}, notes[0]?.data.date ?? new Date());
const fmt = (d) => d.toISOString().slice(0, 10).replace(/-/g, '.');
const iso = (d) => d.toISOString().slice(0, 10);

// 命令面板数据：全部笔记供 Ctrl+K 搜索
const paletteData = {
  links: [{ zh: '主页', en: 'Home', href: '/' }],
  notes: notes.map((n) => ({ id: n.id, title: n.data.title, tags: n.data.tags, summary: n.data.summary ?? '' })),
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#3388bb" />
    <meta name="description" content="YZBzgy 的学习笔记：机器学习、编程、造物记录。" />
    <title>NOTES · YZBZGY</title>
    <meta property="og:image" content="https://zgy0715.github.io/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%233388bb'/%3E%3Ctext x='32' y='45' font-family='sans-serif' font-size='38' font-weight='bold' fill='white' text-anchor='middle'%3EY%3C/text%3E%3C/svg%3E" />
    <link rel="alternate" type="application/rss+xml" title="学习笔记 RSS" href="/rss.xml" />
    <link rel="canonical" href="https://zgy0715.github.io/notes/" />
    <meta property="og:title" content="YZBZGY · 学习笔记" />
    <meta property="og:description" content="机器学习、编程、造物记录。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zgy0715.github.io/notes/" />
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('site-theme');
          var lang = localStorage.getItem('site-lang') || 'zh';
          if (lang === 'en') {
            document.documentElement.classList.add('lang-en');
            document.documentElement.lang = 'en';
          }
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.content = theme === 'dark' ? '#0f1115' : '#3388bb';
      })();
    </script>
    <style is:global>
      :root {
        color-scheme: light;
        --black: #0a0a0a;
        --white: #fff;
        --blue: #3388bb;
        --blue-dark: #287aac;
        --blue-light: #77bbdd;
        --pink: #ff8899;
        --gold: #bb9955;
        --sans: 'IBM Plex Sans SC', sans-serif;
        --display: 'Bebas Neue', sans-serif;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        --pad: clamp(20px, 6vw, 72px);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--white); color: var(--black); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      button { color: inherit; font: inherit; }
      ::selection { color: #fff; background: var(--blue); }
      :focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
      .i18n-en { display: none; }
      html.lang-en .i18n-zh { display: none; }
      html.lang-en .i18n-en { display: inline; }
      h1 .i18n-zh { font-weight: 700; letter-spacing: .06em; }

      .page { min-height: 100svh; display: flex; flex-direction: column; padding: 90px var(--pad) 50px; }

      /* ===== 页头 ===== */
      .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 26px; }
      .page-head h1 { margin: 0; font: 400 clamp(3.4rem, 10vw, 8rem) var(--display); letter-spacing: .04em; line-height: .9; }
      .head-meta { margin: 10px 0 0; font: 10px var(--mono); letter-spacing: .18em; color: #777; }
      .head-meta b { color: var(--blue); font-weight: 700; }
      .back-home { font: 10px var(--mono); letter-spacing: .2em; text-decoration: none; transition: color .2s; white-space: nowrap; }
      .back-home:hover { color: var(--blue); }
      .head-actions { display: flex; align-items: center; gap: 16px; }
      .lang-toggle { display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border: 1px solid rgba(0, 0, 0, .4); border-radius: 999px; background: none; cursor: pointer; font: 10px var(--mono); letter-spacing: .1em; }
      .lang-toggle span { opacity: .4; transition: opacity .2s; }
      html.lang-zh .lang-toggle .lang-zh-mark, html.lang-en .lang-toggle .lang-en-mark { opacity: 1; font-weight: 700; }
      .lang-toggle i { font-style: normal; opacity: .35; }
      .theme-toggle { width: 33px; height: 33px; display: inline-flex; align-items: center; justify-content: center; padding: 0; border: 1px solid rgba(0, 0, 0, .4); border-radius: 50%; background: none; cursor: pointer; font-size: 14px; line-height: 1; transition: transform .3s ease, border-color .2s; }
      .theme-toggle:hover { border-color: #000; transform: rotate(24deg); }
      .skip-link { position: fixed; z-index: 90; top: 12px; left: 12px; padding: 12px 16px; background: var(--black); color: #fff; font: 12px var(--mono); text-decoration: none; transform: translateY(-180%); }
      .skip-link:focus { transform: none; }

      /* ===== 工具栏：标签筛选 + 视图切换 ===== */
      .toolbar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding: 12px 0; margin-bottom: 6px; background: var(--white); border-bottom: 1px solid rgba(0, 0, 0, .15); }
      .tag-filter { display: flex; flex-wrap: wrap; gap: 8px; }
      .chip { display: inline-flex; align-items: center; gap: 7px; padding: 7px 13px; border: 1px solid rgba(0, 0, 0, .3); border-radius: 999px; background: none; cursor: pointer; font: 9px var(--mono); letter-spacing: .12em; transition: background .2s, color .2s, border-color .2s; }
      .chip .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--chip, #999); }
      .chip .star-mark { color: var(--gold); font-size: 11px; }
      .chip:hover { border-color: #000; }
      .chip.active { background: var(--black); border-color: var(--black); color: #fff; }
      .chip.active .dot { background: #fff; }
      .chip.active .star-mark { color: #fff; }
      .search-box { display: inline-flex; align-items: center; gap: 8px; padding: 0 14px; height: 38px; border: 1px solid rgba(0, 0, 0, .3); border-radius: 999px; transition: border-color .2s; }
      .search-box svg { width: 14px; height: 14px; flex: none; color: #888; }
      .search-box input { border: 0; outline: none; background: none; font: 12.5px var(--sans); color: inherit; width: clamp(130px, 20vw, 230px); }
      .search-box input::placeholder { color: #999; }
      .search-box input::-webkit-search-cancel-button { -webkit-appearance: none; }
      .search-box:focus-within { border-color: #000; }
      .view-toggle { display: inline-flex; border: 1px solid rgba(0, 0, 0, .3); }
      .view-toggle button { width: 44px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border: 0; background: none; cursor: pointer; color: #666; transition: background .2s, color .2s; }
      .view-toggle button svg { width: 17px; height: 17px; display: block; }
      .view-toggle button + button { border-left: 1px solid rgba(0, 0, 0, .3); }
      .view-toggle button:hover { color: #000; }
      .view-toggle button.active { background: var(--black); color: #fff; }

      /* ===== 笔记列表（三种视图共用骨架）===== */
      .note-list { display: grid; list-style: none; margin: 14px 0 0; padding: 0; }
      /* 载入 blur-fadein：从焦外到清晰，逐条交错 */
      .note-item { position: relative; opacity: 0; filter: blur(10px); animation: blur-in .9s cubic-bezier(.2, .7, .2, 1) forwards; }
      .note-item:nth-child(2) { animation-delay: .06s; }
      .note-item:nth-child(3) { animation-delay: .12s; }
      .note-item:nth-child(4) { animation-delay: .18s; }
      .note-item:nth-child(5) { animation-delay: .24s; }
      .note-item:nth-child(6) { animation-delay: .3s; }
      .note-item:nth-child(7) { animation-delay: .36s; }
      .note-item:nth-child(8) { animation-delay: .42s; }
      .note-item:nth-child(9) { animation-delay: .48s; }
      .note-item:nth-child(n+10) { animation-delay: .54s; }
      @keyframes blur-in { to { opacity: 1; filter: blur(0); } }
      .note-item .accent { position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--accent-color, var(--blue)); }
      .note-star { color: var(--gold); font-size: 13px; }
      .note-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 0; font: 9px var(--mono); letter-spacing: .16em; color: #777; }
      .meta-icon { width: 11px; height: 11px; display: inline-block; vertical-align: -1.5px; margin-right: 5px; opacity: .6; }
      .note-title { margin: 0; font: 700 1.35rem/1.3 var(--sans); letter-spacing: .02em; transition: color .2s; }
      .note-summary { margin: 9px 0 0; font-size: 13px; line-height: 1.95; color: #444; }
      .note-tags { display: flex; flex-wrap: wrap; gap: 7px; margin: 13px 0 0; }
      .note-tags span { padding: 4px 9px; border: 1px solid; border-radius: 999px; font: 8px var(--mono); letter-spacing: .12em; }
      .note-foot { display: flex; align-items: center; gap: 14px; margin: 14px 0 0; font: 9px var(--mono); letter-spacing: .14em; color: #999; }

      /* —— 列表视图：纯索引（日期 + 标题 + 箭头，不放摘要）—— */
      .view-list { gap: 0; }
      .view-list .note-item { border-bottom: 1px solid rgba(0, 0, 0, .18); }
      .view-list .note-item:first-child { border-top: 1px solid rgba(0, 0, 0, .18); }
      .view-list a { position: relative; display: block; padding: 20px 48px 20px 22px; text-decoration: none; transition: padding-left .25s cubic-bezier(.2, .7, .2, 1); }
      .view-list a::after { content: '→'; position: absolute; right: 8px; top: 50%; transform: translateY(-50%); color: #bbb; font: 14px var(--mono); transition: color .2s, transform .2s; }
      .view-list a:hover { padding-left: 32px; }
      .view-list a:hover::after { color: var(--blue); transform: translateY(-50%) translateX(4px); }
      .view-list a:hover .note-title { color: var(--blue); }
      .view-list .note-summary, .view-list .note-tags, .view-list .note-foot { display: none; }
      .view-list .note-title { font-size: 1.35rem; }

      /* —— 卡片视图：大卡 + 摘要全显 —— */
      .view-cards { gap: 20px; }
      .view-cards .note-item { border: 1px solid rgba(0, 0, 0, .25); background: var(--white); transition: border-color .2s, transform .25s cubic-bezier(.2, .7, .2, 1); }
      .view-cards .note-item:hover { border-color: var(--accent-color, var(--blue)); transform: translateY(-3px); box-shadow: 0 12px 34px -14px rgba(0, 0, 0, .22); }
      .view-cards a { display: block; padding: 26px 28px 24px 32px; text-decoration: none; }
      .view-cards a:hover .note-title { color: var(--blue); }
      .view-cards .note-title { font-size: 1.6rem; }
      .view-cards .note-summary { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
      .view-cards .note-foot { border-top: 1px solid rgba(0, 0, 0, .12); padding-top: 13px; }

      /* —— 网格视图：紧凑磁贴（accent 顶条 + 标题 + 标签，不放摘要）—— */
      .view-grid { grid-template-columns: repeat(auto-fill, minmax(215px, 1fr)); gap: 14px; align-items: stretch; }
      .view-grid .note-item { border: 1px solid rgba(0, 0, 0, .25); display: flex; flex-direction: column; transition: border-color .2s, transform .25s cubic-bezier(.2, .7, .2, 1); }
      .view-grid .note-item:hover { border-color: var(--accent-color, var(--blue)); transform: translateY(-3px); box-shadow: 0 12px 34px -14px rgba(0, 0, 0, .22); }
      .view-grid .note-item .accent { left: 0; right: 0; bottom: auto; width: auto; height: 4px; }
      .view-grid a { display: flex; flex-direction: column; flex: 1; padding: 20px 18px 16px 20px; text-decoration: none; }
      .view-grid a:hover .note-title { color: var(--blue); }
      .view-grid .note-meta { gap: 10px; }
      .view-grid .note-title { font-size: 1.05rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      .view-grid .note-summary, .view-grid .note-foot { display: none; }
      .view-grid .note-tags { margin-top: auto; padding-top: 14px; gap: 6px; }
      .view-grid .note-tags span { padding: 4px 7px; font-size: 7.5px; }

      .empty { padding: 60px 0; color: #666; font-size: 14px; line-height: 2; }

      .page-footer { margin-top: auto; padding-top: 50px; font: 9px var(--mono); letter-spacing: .2em; color: #999; }

      @media (max-width: 760px) {
        .page { padding-top: 72px; }
        .page-head { flex-direction: column; align-items: flex-start; gap: 10px; }
        .toolbar { position: static; }
        .view-grid { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .note-list a, .note-item { transition: none; animation: none; opacity: 1; filter: blur(0); }
      }

      /* ===== 暗色模式（跟随系统）===== */
      /* ===== 暗色主题（手动切换，首次跟随系统）===== */
      [data-theme="dark"] body { background: #0f1115; color: #e8e8e8; }
      [data-theme="dark"] .toolbar { background: #0f1115; border-color: rgba(255, 255, 255, .22); }
      [data-theme="dark"] .chip { border-color: rgba(255, 255, 255, .4); }
      [data-theme="dark"] .chip:hover { border-color: #fff; }
      [data-theme="dark"] .chip.active { background: #fff; border-color: #fff; color: #000; }
      [data-theme="dark"] .chip.active .dot { background: #000; }
      [data-theme="dark"] .chip.active .star-mark { color: #000; }
      [data-theme="dark"] .view-toggle { border-color: rgba(255, 255, 255, .4); }
      [data-theme="dark"] .view-toggle button + button { border-color: rgba(255, 255, 255, .4); }
      [data-theme="dark"] .view-toggle button.active { background: #fff; color: #000; }
      [data-theme="dark"] .view-list .note-item { border-color: rgba(255, 255, 255, .22); }
      [data-theme="dark"] .view-list .note-item:first-child { border-color: rgba(255, 255, 255, .22); }
      [data-theme="dark"] .view-cards .note-item, [data-theme="dark"] .view-grid .note-item { border-color: rgba(255, 255, 255, .3); }
      [data-theme="dark"] .view-cards .note-item:hover, [data-theme="dark"] .view-grid .note-item:hover { border-color: var(--accent-color, var(--blue-light)); }
      [data-theme="dark"] .view-cards .note-foot { border-color: rgba(255, 255, 255, .18); }
      [data-theme="dark"] .view-list a::after { color: #555; }
      [data-theme="dark"] .view-list a:hover::after { color: var(--blue-light); }
      [data-theme="dark"] a:hover .note-title { color: var(--blue-light); }
      [data-theme="dark"] .note-summary { color: #b5b5b5; }
      [data-theme="dark"] .note-meta, [data-theme="dark"] .note-foot { color: #999; }
      [data-theme="dark"] .note-star { color: var(--pink); }
      [data-theme="dark"] .head-meta, [data-theme="dark"] .back-home { color: #999; }
      [data-theme="dark"] .back-home:hover { color: var(--blue-light); }
      [data-theme="dark"] .lang-toggle, [data-theme="dark"] .theme-toggle { border-color: rgba(255, 255, 255, .4); }
      [data-theme="dark"] .theme-toggle:hover { border-color: #fff; }
      [data-theme="dark"] .search-box { border-color: rgba(255, 255, 255, .4); }
      [data-theme="dark"] .search-box svg { color: #999; }
      [data-theme="dark"] .search-box input::placeholder { color: #777; }
      [data-theme="dark"] .search-box:focus-within { border-color: #fff; }
      [data-theme="dark"] .skip-link { background: #fff; color: #000; }
      [data-theme="dark"] .page-footer { color: #777; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#notes-main">跳到主要内容</a>
    <div class="page">
      <header class="page-head">
        <div>
          <h1><span class="i18n-zh">学习笔记</span><span class="i18n-en">NOTES</span></h1>
          <p class="head-meta">
            <b>{notes.length}</b> <span class="i18n-zh">篇</span><span class="i18n-en">posts</span>
            · <span class="i18n-zh">最后更新</span><span class="i18n-en">last updated</span> {fmt(lastUpdated)}
          </p>
        </div>
        <div class="head-actions">
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换明暗主题">☾</button>
          <button class="lang-toggle" id="lang-toggle" type="button" aria-label="切换语言 / Switch language"><span class="lang-zh-mark">中</span><i>/</i><span class="lang-en-mark">EN</span></button>
          <button class="cmdk-chip" type="button" data-cmdk-open aria-label="打开命令面板 (Ctrl+K)">⌘K</button>
          <a class="back-home" href="/"><span aria-hidden="true">←</span> <span class="i18n-zh">回主页</span><span class="i18n-en">BACK HOME</span></a>
        </div>
      </header>

        <div class="toolbar">
        <label class="search-box" for="note-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
          <input type="search" id="note-search" placeholder="搜索标题 / 摘要 / 正文" autocomplete="off" />
        </label>
        <div class="tag-filter" id="tag-filter" aria-label="按标签筛选">
          <button class="chip active" type="button" data-tag="__all__"><span class="i18n-zh">全部</span><span class="i18n-en">ALL</span> {notes.length}</button>
          {starredCount > 0 && <button class="chip" type="button" data-tag="__star__"><span class="star-mark">★</span> <span class="i18n-zh">重要</span><span class="i18n-en">KEY</span> {starredCount}</button>}
          {hotTags.map(([tag, count]) => (
            <button class="chip" type="button" data-tag={tag} style={`--chip:${tagColor(tag)}`}><i class="dot" aria-hidden="true"></i>{tag} {count}</button>
          ))}
        </div>
        <div class="view-toggle" id="view-toggle" role="group" aria-label="切换视图">
          <button type="button" data-view="list" class="active" aria-label="列表视图" title="列表视图">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="6.5" x2="20" y2="6.5"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17.5" x2="20" y2="17.5"/></svg>
          </button>
          <button type="button" data-view="cards" aria-label="卡片视图" title="卡片视图">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="15" rx="1.5"/><line x1="3.5" y1="9.5" x2="20.5" y2="9.5"/></svg>
          </button>
          <button type="button" data-view="grid" aria-label="网格视图" title="网格视图">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="4" y="4" width="6.5" height="6.5" rx="1"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1"/></svg>
          </button>
        </div>
      </div>

      <main id="notes-main">
        <script type="application/json" id="search-data" set:html={JSON.stringify(notes.map((n) => ({
          id: n.id,
          text: (n.data.title + ' ' + (n.data.summary ?? '') + ' ' + n.data.tags.join(' ') + ' ' + (n.body ?? '')).replace(/\s+/g, ' ').slice(0, 5000).toLowerCase(),
        })))} />
        <ul class="note-list view-list" id="note-list">
          {notes.map((note) => (
            <li class="note-item" style={`--accent-color:${note.color}`} data-id={note.id} data-tags={note.data.tags.join('|')} data-star={note.data.star ? '1' : '0'}>
              <a href={`/notes/${note.id}/`}>
                <i class="accent" aria-hidden="true"></i>
                <p class="note-meta">
                  <time datetime={iso(note.data.date)}><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/><line x1="3.5" y1="10.5" x2="20.5" y2="10.5"/></svg>{fmt(note.data.date)}</time>
                  {note.data.updated && note.data.updated.valueOf() !== note.data.date.valueOf() && <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l4-1 10-10-3-3L5 16z"/><path d="M14 6l3 3"/></svg><span class="i18n-zh">更新</span><span class="i18n-en">edited</span> {fmt(note.data.updated)}</span>}
                  <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>≈ {note.minutes} <span class="i18n-zh">分钟</span><span class="i18n-en">min</span></span>
                </p>
                <h2 class="note-title">{note.data.star && <span class="note-star" title="重要" aria-label="重要">★ </span>}{note.data.title}</h2>
                {note.data.summary && <p class="note-summary">{note.data.summary}</p>}
                <p class="note-tags" aria-label="标签">
                  {note.data.tags.map((tag) => <span style={`color:${tagColor(tag)};border-color:${tagColor(tag)}`}>{tag}</span>)}
                </p>
                <p class="note-foot"><span class="i18n-zh">阅读全文</span><span class="i18n-en">READ</span> <span aria-hidden="true">→</span></p>
              </a>
            </li>
          ))}
        </ul>
        <p class="empty" id="no-result" style="display:none">没有匹配的笔记——换个关键词，或清除标签筛选试试。</p>
      </main>

      <footer class="page-footer"><span class="i18n-zh">© 2026 YZBZGY — 建于地球 · 见于线上</span><span class="i18n-en">© 2026 YZBZGY — MADE ON EARTH · FOUND ONLINE</span></footer>
    </div>

    <script>
      // ===== 视图切换（记忆到 localStorage）=====
      const list = document.querySelector('#note-list');
      const viewBox = document.querySelector('#view-toggle');
      const applyView = (view) => {
        list.classList.remove('view-list', 'view-cards', 'view-grid');
        list.classList.add('view-' + view);
        [...viewBox.querySelectorAll('button')].forEach((b) => b.classList.toggle('active', b.dataset.view === view));
        try { localStorage.setItem('notes-view', view); } catch (e) {}
      };
      viewBox?.addEventListener('click', (event) => {
        const btn = event.target.closest('button');
        if (btn) applyView(btn.dataset.view);
      });
      applyView((() => { try { return localStorage.getItem('notes-view') || 'list'; } catch (e) { return 'list'; } })());

      // ===== 标签筛选 + 搜索（合并过滤）=====
      const items = [...list.querySelectorAll('.note-item')];
      const filterBox = document.querySelector('#tag-filter');
      const searchInput = document.querySelector('#note-search');
      const noResult = document.querySelector('#no-result');
      const searchData = new Map(JSON.parse(document.querySelector('#search-data').textContent).map((o) => [o.id, o.text]));
      let activeTag = '__all__';
      let query = '';
      const applyFilters = () => {
        const q = query.trim().toLowerCase();
        let visible = 0;
        items.forEach((item) => {
          const tagOk = activeTag === '__all__'
            || (activeTag === '__star__' ? item.dataset.star === '1' : item.dataset.tags.split('|').includes(activeTag));
          const textOk = !q || (searchData.get(item.dataset.id) || '').includes(q);
          const ok = tagOk && textOk;
          item.style.display = ok ? '' : 'none';
          if (ok) visible += 1;
        });
        filterBox.querySelectorAll('.chip').forEach((chip) => chip.classList.toggle('active', chip.dataset.tag === activeTag));
        if (noResult) noResult.style.display = visible === 0 ? '' : 'none';
      };
      filterBox?.addEventListener('click', (event) => {
        const chip = event.target.closest('.chip');
        if (!chip) return;
        activeTag = chip.dataset.tag;
        applyFilters();
      });
      searchInput?.addEventListener('input', () => {
        query = searchInput.value;
        applyFilters();
      });
      applyFilters();

      // ===== 中 / EN 语言切换（与主页共享 localStorage）=====
      const rootHtml = document.documentElement;
      const langToggle = document.querySelector('#lang-toggle');
      const applyLang = (lang) => {
        rootHtml.classList.toggle('lang-en', lang === 'en');
        rootHtml.classList.toggle('lang-zh', lang !== 'en');
        rootHtml.lang = lang === 'en' ? 'en' : 'zh-CN';
        document.title = lang === 'en' ? 'NOTES · YZBZGY' : '学习笔记 · YZBZGY';
        if (searchInput) searchInput.placeholder = lang === 'en' ? 'Search title / summary / body' : '搜索标题 / 摘要 / 正文';
        try { localStorage.setItem('site-lang', lang); } catch (e) {}
      };
      applyLang(rootHtml.classList.contains('lang-en') ? 'en' : 'zh');
      langToggle?.addEventListener('click', () => {
        applyLang(rootHtml.classList.contains('lang-en') ? 'zh' : 'en');
      });

      // ===== 明暗主题切换（与主页共享 localStorage）=====
      const themeToggle = document.querySelector('#theme-toggle');
      const applyTheme = (theme) => {
        rootHtml.dataset.theme = theme;
        if (themeToggle) {
          themeToggle.textContent = theme === 'dark' ? '☀' : '☾';
          themeToggle.setAttribute('aria-label', theme === 'dark' ? '切换到浅色模式' : '切换到深色模式');
        }
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.content = theme === 'dark' ? '#0f1115' : '#3388bb';
        try { localStorage.setItem('site-theme', theme); } catch (e) {}
      };
      applyTheme(rootHtml.dataset.theme === 'dark' ? 'dark' : 'light');
      themeToggle?.addEventListener('click', () => {
        applyTheme(rootHtml.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    </script>

    <script type="application/json" id="palette-data" set:html={JSON.stringify(paletteData)} />
    <CommandPalette />
  </body>
</html>
