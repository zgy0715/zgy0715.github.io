---
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#3388bb" />
    <meta name="description" content="YZBzgy 的学习笔记：机器学习、编程、造物记录。" />
    <title>NOTES · YZBZGY</title>
    <script is:inline>
      (function () {
        try {
          var lang = localStorage.getItem('site-lang') || 'zh';
          if (lang === 'en') {
            document.documentElement.classList.add('lang-en');
            document.documentElement.lang = 'en';
          }
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        color-scheme: light;
        --black: #0a0a0a;
        --white: #fff;
        --blue: #3388bb;
        --blue-dark: #287aac;
        --blue-light: #77bbdd;
        --pink: #ff8899;
        --sans: 'IBM Plex Sans SC', sans-serif;
        --display: 'Bebas Neue', sans-serif;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        --pad: clamp(20px, 6vw, 72px);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--white); color: var(--black); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      ::selection { color: #fff; background: var(--blue); }
      :focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
      .i18n-en { display: none; }
      html.lang-en .i18n-zh { display: none; }
      html.lang-en .i18n-en { display: inline; }
      h1 .i18n-zh, h2 .i18n-zh { font-weight: 700; letter-spacing: .06em; }

      .page { min-height: 100svh; display: flex; flex-direction: column; padding: 96px var(--pad) 60px; }
      .page-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 40px; }
      .page-head h1 { margin: 0; font: 400 clamp(3.4rem, 10vw, 8rem) var(--display); letter-spacing: .04em; line-height: .9; }
      .back-home { font: 10px var(--mono); letter-spacing: .2em; text-decoration: none; transition: color .2s; }
      .back-home:hover { color: var(--blue); }

      .note-list { list-style: none; margin: 0; padding: 0; }
      .note-list li { border-top: 1px solid rgba(0, 0, 0, .2); }
      .note-list li:last-child { border-bottom: 1px solid rgba(0, 0, 0, .2); }
      .note-list a { display: block; padding: clamp(20px, 3.5vw, 34px) 0; text-decoration: none; transition: padding-left .25s cubic-bezier(.2, .7, .2, 1); }
      .note-list a:hover { padding-left: 14px; }
      .note-list a:hover .note-title { color: var(--blue); }
      .note-meta { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin: 0 0 8px; font: 9px var(--mono); letter-spacing: .18em; color: #666; }
      .note-title { margin: 0; font: 700 clamp(1.5rem, 4vw, 2.6rem)/1.15 var(--sans); letter-spacing: .02em; transition: color .2s; }
      .note-summary { margin: 10px 0 0; max-width: 620px; font-size: 13.5px; line-height: 2; color: #444; }
      .note-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
      .note-tags span { padding: 6px 10px; border: 1px solid rgba(0, 0, 0, .35); border-radius: 999px; font: 8px var(--mono); letter-spacing: .14em; }
      .empty { padding: 60px 0; color: #666; font-size: 14px; line-height: 2; }

      .page-footer { margin-top: auto; padding-top: 50px; font: 9px var(--mono); letter-spacing: .2em; color: #999; }

      @media (max-width: 760px) {
        .page { padding-top: 72px; }
        .page-head { flex-direction: column; gap: 10px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .note-list a { transition: none; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="page-head">
        <h1><span class="i18n-zh">学习笔记</span><span class="i18n-en">NOTES</span></h1>
        <a class="back-home" href="/"><span aria-hidden="true">←</span> <span class="i18n-zh">回主页</span><span class="i18n-en">BACK HOME</span></a>
      </header>
      <main>
        {notes.length === 0 ? (
          <p class="empty">还没有笔记，第一篇正在路上。</p>
        ) : (
          <ul class="note-list">
            {notes.map((note) => (
              <li>
                <a href={`/notes/${note.id}/`}>
                  <p class="note-meta">
                    <time datetime={note.data.date.toISOString().slice(0, 10)}>{note.data.date.toISOString().slice(0, 10)}</time>
                    {note.data.tags.map((tag) => <span>{tag}</span>)}
                  </p>
                  <h2 class="note-title">{note.data.title}</h2>
                  {note.data.summary && <p class="note-summary">{note.data.summary}</p>}
                </a>
              </li>
            ))}
          </ul>
        )}
      </main>
      <footer class="page-footer"><span class="i18n-zh">© 2026 YZBZGY — 建于地球 · 见于线上</span><span class="i18n-en">© 2026 YZBZGY — MADE ON EARTH · FOUND ONLINE</span></footer>
    </div>
  </body>
</html>
